---
interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
}
const { eyebrow, title, lede } = Astro.props;
---

<div class="pt-10 pb-7">
  {
    eyebrow && (
      <p class="label !mb-2" style="color: var(--accent)">
        {eyebrow}
      </p>
    )
  }
  <h1 class="text-3xl md:text-[2.4rem] font-semibold">{title}</h1>
  {
    lede && (
      <p class="mt-3 text-[1.05rem] max-w-2xl leading-relaxed" style="color: var(--text-muted)">
        {lede}
      </p>
    )
  }
  <slot />
</div>
