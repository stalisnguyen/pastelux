---
import { nav, site, url, AI_PROXY_URL } from '../site';
import ThemeToggle from './ThemeToggle.astro';
import SearchTrigger from './SearchTrigger.astro';
import ViToggle from './ViToggle.astro';

const path = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/';
const isActive = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(href + '/');

// Vietnamese name of each section — shown instead of the English in VI mode.
const viNav: Record<string, string> = {
  '/': 'Hôm nay',
  '/learn': 'Kiến thức',
  '/projects': 'Dự án',
  '/standards': 'Tiêu chuẩn',
  '/directory': 'Danh bạ',
  '/tools': 'Công cụ',
  '/board': 'Bảng nháp',
  '/glossary': 'Thuật ngữ',
  '/events': 'Sự kiện',
};
---

<header
  class="sticky top-0 z-40 backdrop-blur-xl border-b"
  style="background: color-mix(in srgb, var(--bg) 86%, transparent); border-color: var(--border)"
>
  <div class="container-page flex h-14 items-center gap-4">
    <a
      href={url('/')}
      class="flex items-center gap-2.5 shrink-0 no-underline"
      style="color: var(--text)"
      aria-label={`${site.name} home`}
    >
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <circle cx="12" cy="12" r="4.2" fill="var(--accent)"></circle>
        <g stroke="var(--accent)" stroke-width="1.6" stroke-linecap="round" opacity="0.55">
          <path d="M12 1.6v3M12 19.4v3M1.6 12h3M19.4 12h3"></path>
          <path d="M4.7 4.7l2.1 2.1M17.2 17.2l2.1 2.1M19.3 4.7l-2.1 2.1M6.8 17.2l-2.1 2.1"></path>
        </g>
      </svg>
      <span class="font-semibold tracking-tight text-[1.05rem]">{site.name}</span>
    </a>

    <nav class="hidden lg:flex items-center gap-0 xl:gap-0.5 ml-0 xl:ml-2" aria-label="Main">
      {
        nav.map((item) => (
          <a
            href={url(item.href)}
            class="px-1.5 xl:px-2.5 py-1.5 rounded-lg text-[0.84rem] xl:text-[0.9rem] font-medium no-underline transition-colors hover:no-underline whitespace-nowrap"
            style={
              isActive(item.href)
                ? 'color: var(--text); background: var(--surface)'
                : 'color: var(--text-muted)'
            }
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            <span>{item.label}</span>
            {viNav[item.href] && <span class="vi-block-inline">{viNav[item.href]}</span>}
          </a>
        ))
      }
    </nav>

    <div class="ml-auto flex items-center gap-2">
      <a
        id="ask-link"
        href={url('/ask')}
        class="btn !px-2 !py-1.5 hidden"
        title="Stas · AI"
        aria-label="Ask Stas"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 3l1.8 4.6L18.5 9.5l-4.7 1.9L12 16l-1.8-4.6L5.5 9.5l4.7-1.9z"></path>
          <path d="M19 15l.8 2 2 .8-2 .8-.8 2-.8-2-2-.8 2-.8z"></path>
        </svg>
      </a>
      <SearchTrigger />
      <ViToggle />
      <ThemeToggle />
    </div>
  </div>
</header>

<script is:inline define:vars={{ proxy: AI_PROXY_URL }}>
  // Ask AI is private: the button only exists on devices unlocked with the code
  (() => {
    try {
      if (proxy && localStorage.getItem('pastelux-ai-code')) document.getElementById('ask-link')?.classList.remove('hidden');
    } catch {}
  })();
</script>
