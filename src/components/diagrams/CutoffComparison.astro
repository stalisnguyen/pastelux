---
import Figure from '../Figure.astro';

const W = 640;
const H = 300;
const GROUND = 236;
const POLE = 62;
---

<Figure
  label="Comparison of an uncontrolled exterior luminaire and a full cut-off one"
  caption="Full cut-off means zero intensity at or above 90° from nadir and no more than 10% above 80°. The same lamp, the same pole: on the right every lumen lands where it was intended, which is simultaneously the light-pollution argument, the energy argument and the design argument."
>
  <svg viewBox={`0 0 ${W} ${H}`} role="img">
    <defs>
      <linearGradient id="co-sky" x1="0" y1="1" x2="0" y2="0">
        <stop offset="0%" stop-color="var(--danger)" stop-opacity="0.3" />
        <stop offset="100%" stop-color="var(--danger)" stop-opacity="0" />
      </linearGradient>
      <linearGradient id="co-good" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="var(--accent)" stop-opacity="0.4" />
        <stop offset="100%" stop-color="var(--accent)" stop-opacity="0.05" />
      </linearGradient>
      <linearGradient id="co-bad" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="var(--accent)" stop-opacity="0.28" />
        <stop offset="100%" stop-color="var(--accent)" stop-opacity="0.04" />
      </linearGradient>
    </defs>

    <!-- ============ uncontrolled ============ -->
    <g>
      <text class="d-label-strong" x="24" y="18" fill="var(--danger)">UNCONTROLLED</text>

      <!-- wasted uplight -->
      <path d={`M 150 ${POLE} L 40 12 L 260 12 Z`} fill="url(#co-sky)" />
      <text class="d-label" x="150" y="34" text-anchor="middle" fill="var(--danger)">
        upward waste
      </text>

      <!-- sideways glare -->
      <path d={`M 150 ${POLE} L 20 ${POLE + 34} L 20 ${GROUND} Z`} fill="url(#co-bad)" />
      <path d={`M 150 ${POLE} L 280 ${POLE + 34} L 280 ${GROUND} Z`} fill="url(#co-bad)" />

      <!-- downward -->
      <path d={`M 150 ${POLE} L 76 ${GROUND} L 224 ${GROUND} Z`} fill="url(#co-bad)" />

      <!-- exposed source -->
      <circle cx="150" cy={POLE} r="7" fill="var(--accent)" />
      <circle cx="150" cy={POLE} r="12" fill="var(--accent)" fill-opacity="0.28" />

      <line class="d-solid" x1="150" y1={POLE + 6} x2="150" y2={GROUND} />
      <line class="d-solid" x1="24" y1={GROUND} x2="290" y2={GROUND} />

      <text class="d-label" x="24" y={GROUND + 20}>ULR &gt; 0 · glare at every angle</text>
    </g>

    <line class="d-dash" x1="320" y1="10" x2="320" y2={H - 30} />

    <!-- ============ full cut-off ============ -->
    <g>
      <text class="d-label-strong" x="350" y="18" fill="var(--success)">FULL CUT-OFF</text>

      <!-- 90 degree line, nothing above it -->
      <line class="d-dash" x1="360" y1={POLE} x2={W - 24} y2={POLE} stroke="var(--success)" />
      <text class="d-label" x={W - 24} y={POLE - 7} text-anchor="end" fill="var(--success)">
        90° — zero emission above
      </text>

      <path d={`M 480 ${POLE} L 404 ${GROUND} L 556 ${GROUND} Z`} fill="url(#co-good)" />

      <!-- shielded housing conceals the source -->
      <path
        d="M 462 52 L 498 52 L 504 62 L 456 62 Z"
        fill="var(--surface)"
        stroke="var(--border-strong)"
        stroke-width="1.2"
      />
      <circle cx="480" cy={POLE - 1} r="3.4" class="d-accent" />

      <line class="d-solid" x1="480" y1={POLE + 2} x2="480" y2={GROUND} />
      <line class="d-solid" x1="350" y1={GROUND} x2={W - 24} y2={GROUND} />

      <ellipse cx="480" cy={GROUND} rx="76" ry="9" fill="var(--accent)" fill-opacity="0.3" />

      <text class="d-label" x="350" y={GROUND + 20}>ULR = 0 · source hidden from view</text>
    </g>

    <!-- stars, to make the point -->
    {
      [
        [372, 30],
        [420, 20],
        [560, 26],
        [600, 40],
        [520, 16],
      ].map(([x, y]) => <circle cx={x} cy={y} r="1.5" fill="var(--text-muted)" opacity="0.75" />)
    }
  </svg>
</Figure>
