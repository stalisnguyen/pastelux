---
import Figure from '../Figure.astro';

/**
 * One section through an interior and one through an exterior, with each
 * luminaire family drawn where it actually sits. Organised by position rather
 * than by catalogue category, because position is what a designer chooses
 * first — the product follows from it.
 *
 * Labels sit in their own bands above each section. An earlier version put
 * them in the ceiling zone alongside the fittings and they collided.
 */

const W = 660;
const H = 500;

// Interior
const I_LABEL = 30; // label band
const SLAB_Y = 46;
const CEIL = 74;
const FLOOR = 250;

// Exterior
const E_TITLE = 300;
const E_LABEL = 322;
const GROUND = 452;

const RIGHT = W - 26;
---

<Figure
  label="Section showing where each family of luminaire sits, indoors and outdoors"
  caption="Interior above, exterior below. Grouped by where the fitting sits — recessed, suspended, concealed, exterior — because that is the decision a designer makes first; the product follows from it. Every label is a term in the glossary."
>
  <svg viewBox={`0 0 ${W} ${H}`} role="img">
    <defs>
      <linearGradient id="lt-cone" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="var(--accent)" stop-opacity="0.34" />
        <stop offset="100%" stop-color="var(--accent)" stop-opacity="0.03" />
      </linearGradient>
      <linearGradient id="lt-wash" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="var(--accent)" stop-opacity="0.44" />
        <stop offset="100%" stop-color="var(--accent)" stop-opacity="0.06" />
      </linearGradient>
      <linearGradient id="lt-cove" x1="0" y1="1" x2="0" y2="0">
        <stop offset="0%" stop-color="var(--accent)" stop-opacity="0.34" />
        <stop offset="100%" stop-color="var(--accent)" stop-opacity="0" />
      </linearGradient>
    </defs>

    <!-- ============================ INTERIOR ============================ -->
    <text class="d-label-strong" x="26" y="16" fill="var(--accent)">INTERIOR</text>

    <!-- label band, with leader lines down to each fitting -->
    <g>
      <text class="d-label" x="72" y={I_LABEL} text-anchor="middle">downlight</text>
      <line class="d-line" x1="72" y1={I_LABEL + 6} x2="72" y2={SLAB_Y} opacity="0.5" />

      <text class="d-label" x="196" y={I_LABEL} text-anchor="middle">adjustable spot</text>
      <line class="d-line" x1="196" y1={I_LABEL + 6} x2="196" y2={SLAB_Y} opacity="0.5" />

      <text class="d-label" x="356" y={I_LABEL} text-anchor="middle">suspended linear</text>
      <line class="d-line" x1="356" y1={I_LABEL + 6} x2="356" y2={SLAB_Y} opacity="0.5" />

      <text class="d-label" x="482" y={I_LABEL} text-anchor="middle">cove</text>
      <line class="d-line" x1="482" y1={I_LABEL + 6} x2="482" y2={SLAB_Y} opacity="0.5" />

      <text class="d-label" x={RIGHT - 8} y={I_LABEL} text-anchor="end">wall washer</text>
      <line class="d-line" x1={RIGHT - 46} y1={I_LABEL + 6} x2={RIGHT - 46} y2={SLAB_Y} opacity="0.5" />
    </g>

    <!-- structural slab -->
    <rect x="26" y={SLAB_Y} width={RIGHT - 26} height="10" fill="var(--surface)" stroke="var(--border-strong)" />
    <text class="d-label" x="30" y={SLAB_Y + 24} opacity="0.75">ceiling void</text>

    <!-- ceiling, wall, floor -->
    <line class="d-solid" x1="26" y1={CEIL} x2={RIGHT} y2={CEIL} />
    <line class="d-solid" x1={RIGHT} y1={CEIL} x2={RIGHT} y2={FLOOR} />
    <line class="d-solid" x1="26" y1={FLOOR} x2={RIGHT} y2={FLOOR} />
    <text class="d-label" x="30" y={FLOOR + 15} opacity="0.75">floor</text>

    <!-- 1. recessed downlight -->
    <g>
      <rect x="57" y={CEIL - 15} width="30" height="15" rx="1.5" class="d-surface" />
      <circle cx="72" cy={CEIL - 2} r="3" class="d-accent" />
      <path d={`M 72 ${CEIL} L 38 ${FLOOR} L 106 ${FLOOR} Z`} fill="url(#lt-cone)" />
    </g>

    <!-- 2. adjustable spot, tilted -->
    <g>
      <rect x="181" y={CEIL - 15} width="30" height="15" rx="1.5" class="d-surface" />
      <g transform={`rotate(26 196 ${CEIL - 5})`}>
        <rect x="188" y={CEIL - 13} width="16" height="13" rx="1.5" fill="var(--bg-elevated)" stroke="var(--border-strong)" />
        <circle cx="196" cy={CEIL - 3} r="2.6" class="d-accent" />
      </g>
      <path d={`M 201 ${CEIL} L 246 ${FLOOR} L 282 ${FLOOR} Z`} fill="url(#lt-cone)" />
    </g>

    <!-- 3. suspended linear, direct + indirect -->
    <g>
      <line class="d-line" x1="332" y1={CEIL} x2="332" y2={CEIL + 40} />
      <line class="d-line" x1="380" y1={CEIL} x2="380" y2={CEIL + 40} />
      <rect x="320" y={CEIL + 40} width="72" height="10" rx="2" class="d-surface" />
      <!-- upward component -->
      <path d={`M 356 ${CEIL + 38} L 322 ${CEIL + 2} L 390 ${CEIL + 2} Z`} fill="var(--accent)" fill-opacity="0.15" />
      <!-- downward component -->
      <path d={`M 356 ${CEIL + 50} L 314 ${FLOOR} L 398 ${FLOOR} Z`} fill="url(#lt-cone)" />
      <text class="d-label" x="356" y={CEIL + 68} text-anchor="middle" opacity="0.75">direct + indirect</text>
    </g>

    <!-- 4. cove, throwing up onto the ceiling -->
    <g>
      <path
        d={`M 462 ${CEIL - 20} L 462 ${CEIL} L 500 ${CEIL} L 500 ${CEIL - 20} Z`}
        fill="var(--bg-elevated)"
        stroke="var(--border-strong)"
      />
      <circle cx="470" cy={CEIL - 6} r="2.4" class="d-accent" />
      <rect x="500" y={CEIL - 22} width={RIGHT - 500} height="22" fill="url(#lt-cove)" />
    </g>

    <!-- 5. recessed wall washer -->
    <g>
      <rect x={RIGHT - 61} y={CEIL - 15} width="30" height="15" rx="1.5" class="d-surface" />
      <circle cx={RIGHT - 46} cy={CEIL - 2} r="3" class="d-accent" />
      <path
        d={`M ${RIGHT - 38} ${CEIL} L ${RIGHT} ${CEIL + 8} L ${RIGHT} ${FLOOR} L ${RIGHT - 20} ${FLOOR} Z`}
        fill="url(#lt-wash)"
      />
    </g>

    <!-- ============================ EXTERIOR ============================ -->
    <text class="d-label-strong" x="26" y={E_TITLE} fill="var(--accent)">EXTERIOR</text>

    <g>
      <text class="d-label" x="86" y={E_LABEL} text-anchor="middle">bollard</text>
      <text class="d-label" x="246" y={E_LABEL} text-anchor="middle">inground uplight</text>
      <text class="d-label" x="418" y={E_LABEL} text-anchor="middle">pole-top, full cut-off</text>
      <text class="d-label" x={RIGHT - 6} y={E_LABEL} text-anchor="end">façade grazer</text>
    </g>

    <line class="d-solid" x1="26" y1={GROUND} x2={RIGHT} y2={GROUND} />
    <text class="d-label" x="30" y={GROUND + 15} opacity="0.75">ground</text>

    <!-- bollard -->
    <g>
      <rect x="80" y={GROUND - 44} width="12" height="44" rx="2" class="d-surface" />
      <path d={`M 86 ${GROUND - 38} L 54 ${GROUND} L 118 ${GROUND} Z`} fill="url(#lt-cone)" />
    </g>

    <!-- inground uplight, aimed at a tree trunk -->
    <g>
      <rect x="234" y={GROUND - 7} width="24" height="7" rx="1.5" class="d-surface" />
      <circle cx="246" cy={GROUND - 4} r="2.4" class="d-accent" />
      <path d={`M 246 ${GROUND - 8} L 224 ${E_LABEL + 22} L 268 ${E_LABEL + 22} Z`} fill="url(#lt-cone)" />
    </g>

    <!-- pole-top, nothing above the horizontal -->
    <g>
      <line class="d-solid" x1="418" y1={GROUND} x2="418" y2={GROUND - 86} />
      <path
        d={`M 400 ${GROUND - 94} L 436 ${GROUND - 94} L 442 ${GROUND - 84} L 394 ${GROUND - 84} Z`}
        fill="var(--surface)"
        stroke="var(--border-strong)"
      />
      <circle cx="418" cy={GROUND - 86} r="2.4" class="d-accent" />
      <path d={`M 418 ${GROUND - 83} L 366 ${GROUND} L 470 ${GROUND} Z`} fill="url(#lt-cone)" />
      <line class="d-dash" x1="376" y1={GROUND - 84} x2="462" y2={GROUND - 84} stroke="var(--success)" />
    </g>

    <!-- façade grazer, close offset -->
    <g>
      <line class="d-solid" x1={RIGHT - 34} y1={GROUND} x2={RIGHT - 34} y2={GROUND - 108} />
      <rect x={RIGHT - 58} y={GROUND - 8} width="18" height="8" rx="1.5" class="d-surface" />
      <path
        d={`M ${RIGHT - 47} ${GROUND - 9} L ${RIGHT - 36} ${GROUND - 108} L ${RIGHT - 28} ${GROUND - 108} L ${RIGHT - 32} ${GROUND - 9} Z`}
        fill="url(#lt-wash)"
      />
    </g>
  </svg>
</Figure>
