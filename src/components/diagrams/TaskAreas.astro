---
import Figure from '../Figure.astro';

const W = 640;
const H = 300;
---

<Figure
  label="Plan showing the task area, immediate surrounding area and background area defined by EN 12464-1"
  caption="EN 12464-1:2021 tiers the requirement outward from the task rather than flooding the whole room. Pin the task locations down early — if they are unknown at design stage the entire room must be treated as task area, which is far more expensive to build and to run."
  viCaption="EN 12464-1:2021 đặt yêu cầu theo từng lớp, từ vùng nhiệm vụ lan dần ra ngoài, thay vì rải sáng đều khắp phòng: <b>TASK</b> vùng nhiệm vụ (Uo ≥ 0.60) · <b>Immediate surrounding</b> vùng xung quanh liền kề, dải ≥ 0.5 m (Uo ≥ 0.40) · <b>Background area</b> vùng nền, dải ≥ 3 m (Uo ≥ 0.10); Uo là độ đồng đều. Ví dụ tính (<b>Worked example</b>) với vùng nhiệm vụ 500 lx: vùng xung quanh 300 lx, vùng nền 100 lx; bản 2021 còn yêu cầu thêm độ rọi trụ (<b>cylindrical</b>) ≥ 150 lx, tường (<b>walls</b>) ≥ 75 lx, trần (<b>ceiling</b>) ≥ 50 lx. Nên chốt vị trí vùng nhiệm vụ thật sớm — nếu đến giai đoạn thiết kế vẫn chưa rõ, cả phòng phải tính là vùng nhiệm vụ, tốn kém hơn nhiều cả lúc thi công lẫn khi vận hành."
>
  <svg viewBox={`0 0 ${W} ${H}`} role="img">
    <!-- background area -->
    <rect x="24" y="24" width="400" height="252" rx="3" fill="var(--surface)" stroke="var(--border-strong)" />
    <text class="d-label-strong" x="36" y="44">Background area</text>
    <text class="d-label" x="36" y="59">≥ 3 m band · ⅓ of surrounding · Uo ≥ 0.10</text>

    <!-- immediate surrounding -->
    <rect
      x="96"
      y="86"
      width="256"
      height="130"
      rx="3"
      fill="var(--accent)"
      fill-opacity="0.09"
      stroke="var(--accent)"
      stroke-opacity="0.4"
    />
    <text class="d-label-strong" x="108" y="104">Immediate surrounding</text>
    <text class="d-label" x="108" y="118">≥ 0.5 m band · Uo ≥ 0.40</text>

    <!-- task area -->
    <rect
      x="160"
      y="130"
      width="128"
      height="52"
      rx="3"
      fill="var(--accent)"
      fill-opacity="0.32"
      stroke="var(--accent)"
      stroke-width="1.6"
    />
    <text class="d-label-strong" x="224" y="152" text-anchor="middle" fill="var(--accent)">TASK</text>
    <text class="d-label" x="224" y="166" text-anchor="middle">Ēm · Uo ≥ 0.60</text>

    <!-- dimension for the 0.5 m band -->
    <line class="d-line" x1="96" y1="230" x2="160" y2="230" />
    <line class="d-line" x1="96" y1="225" x2="96" y2="235" />
    <line class="d-line" x1="160" y1="225" x2="160" y2="235" />
    <text class="d-label" x="128" y="246" text-anchor="middle">≥ 0.5 m</text>

    <!-- ============ the tier table ============ -->
    <g transform="translate(452, 60)">
      <text class="d-label-strong" x="0" y="0">Worked example — 500 lx task</text>

      {
        [
          { label: 'Task', v: '500 lx', o: 1, w: 100 },
          { label: 'Surrounding', v: '300 lx', o: 0.62, w: 60 },
          { label: 'Background', v: '100 lx', o: 0.3, w: 20 },
        ].map((row, i) => (
          <g transform={`translate(0, ${28 + i * 46})`}>
            <text class="d-label" x="0" y="0">
              {row.label}
            </text>
            <rect x="0" y="8" width="130" height="14" rx="2" fill="var(--border)" opacity="0.5" />
            <rect
              x="0"
              y="8"
              width={row.w * 1.3}
              height="14"
              rx="2"
              fill="var(--accent)"
              fill-opacity={row.o}
            />
            <text class="d-label-strong" x="0" y="34" fill="var(--accent)">
              {row.v}
            </text>
          </g>
        ))
      }

      <text class="d-label" x="0" y="182">Plus, in the 2021 edition:</text>
      <text class="d-label" x="0" y="196">cylindrical ≥ 150 lx</text>
      <text class="d-label" x="0" y="209">walls ≥ 75 lx · ceiling ≥ 50 lx</text>
    </g>
  </svg>
</Figure>
