---
import { site, url } from '../site';
const year = new Date().getFullYear();
---

<footer class="border-t mt-8" style="border-color: var(--border)">
  <div class="container-page py-10">
    <div class="flex flex-wrap gap-8 justify-between">
      <div class="max-w-sm">
        <p class="font-semibold">{site.name}</p>
        <p class="text-sm mt-1.5 leading-relaxed" style="color: var(--text-muted)">
          {site.description}
        </p>
        <p class="vi-block vi-def text-[0.82rem] mt-1.5 leading-relaxed">
          Kiến thức thực hành cho người làm thiết kế chiếu sáng — từ trắc quang, tiêu chuẩn đến điều khiển và chiếu sáng vì con người. Cùng bản tin ngành cập nhật mỗi sáng.
        </p>
      </div>

      <div class="flex gap-10 text-sm">
        <div>
          <p class="label">Knowledge<span class="vi-block-inline" style="color: var(--vi-text)"> · Kiến thức</span></p>
          <ul class="space-y-1.5" style="color: var(--text-muted)">
            <li><a href={url('/learn')} class="no-underline hover:underline"><span>Articles</span><span class="vi-block-inline">Bài viết</span></a></li>
            <li><a href={url('/standards')} class="no-underline hover:underline"><span>Standards</span><span class="vi-block-inline">Tiêu chuẩn</span></a></li>
            <li><a href={url('/glossary')} class="no-underline hover:underline"><span>Glossary</span><span class="vi-block-inline">Thuật ngữ</span></a></li>
          </ul>
        </div>
        <div>
          <p class="label">Daily<span class="vi-block-inline" style="color: var(--vi-text)"> · Hằng ngày</span></p>
          <ul class="space-y-1.5" style="color: var(--text-muted)">
            <li><a href={url('/')} class="no-underline hover:underline"><span>Today</span><span class="vi-block-inline">Hôm nay</span></a></li>
            <li><a href={url('/archive')} class="no-underline hover:underline"><span>Archive</span><span class="vi-block-inline">Lưu trữ</span></a></li>
            <li><a href={url('/events')} class="no-underline hover:underline"><span>Events</span><span class="vi-block-inline">Sự kiện</span></a></li>
          </ul>
        </div>
      </div>
    </div>

    <div
      class="mt-8 pt-6 border-t flex flex-wrap gap-x-6 gap-y-2 text-xs"
      style="border-color: var(--border); color: var(--text-faint)"
    >
      <span>© {year} {site.name}</span>
      <a href={url('/about')} class="no-underline hover:underline">About &amp; sources<span class="vi-block-inline" style="color: var(--vi-text)"> · Giới thiệu &amp; nguồn tin</span></a>
      <span
        >Headlines are linked to their publishers. Summaries are written here, not copied.</span
      >
      <span class="vi-block w-full" style="color: var(--vi-text)">
        Tiêu đề dẫn thẳng về trang gốc. Phần tóm tắt do Pastelux tự viết, không sao chép.
      </span>
    </div>

    <!-- A small dedication. The site name is already both of ours: Pastel + lux. -->
    <p class="dedication mt-6 text-xs flex items-center gap-1.5" style="color: var(--text-faint)">
      <span>Made by <b>Stalis</b> for <b>Pastel</b>, with</span>
      <svg
        class="heart"
        width="13"
        height="13"
        viewBox="0 0 24 24"
        aria-hidden="true"
        style="fill: var(--accent-cool)"
      >
        <path
          d="M12 21s-8-5.1-10.2-9.6C.5 8.4 2 5 5.3 5c2 0 3.3 1.1 4.2 2.3L12 10l2.5-2.7C15.4 6.1 16.7 5 18.7 5 22 5 23.5 8.4 22.2 11.4 20 15.9 12 21 12 21z"
        ></path>
      </svg>
      <span class="sr-only">love</span>
    </p>
  </div>
</footer>

<style>
  .heart {
    transform-origin: center;
    animation: heartbeat 2.6s ease-in-out infinite;
  }
  @keyframes heartbeat {
    0%,
    18%,
    100% {
      transform: scale(1);
    }
    8% {
      transform: scale(1.22);
    }
    12% {
      transform: scale(1.06);
    }
  }
  .dedication:hover .heart {
    animation-duration: 0.9s;
  }
  @media (prefers-reduced-motion: reduce) {
    .heart {
      animation: none;
    }
  }
</style>
