---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';

const all = (await getCollection('events')).sort((a, b) =>
  a.data.start.localeCompare(b.data.start)
);
const now = Date.now();
const upcoming = all.filter((e) => Date.parse(e.data.end ?? e.data.start) >= now);
const past = all.filter((e) => Date.parse(e.data.end ?? e.data.start) < now).reverse();

const kindStyle: Record<string, string> = {
  conference: 'color: var(--accent-cool)',
  fair: 'color: var(--accent)',
  award: 'color: var(--success)',
  deadline: 'color: var(--warning)',
};
// Vietnamese name of each kind — shown as a tooltip, the chip is too small for a second voice.
const viKind: Record<string, string> = {
  conference: 'Hội thảo',
  fair: 'Hội chợ triển lãm',
  award: 'Giải thưởng',
  deadline: 'Hạn nộp',
};

const range = (e: { start: string; end?: string }) => {
  const s = new Date(`${e.start}T00:00:00Z`);
  const opts = { day: 'numeric', month: 'short', timeZone: 'UTC' } as const;
  if (!e.end) return `${s.toLocaleDateString('en-GB', opts)} ${s.getUTCFullYear()}`;
  const en = new Date(`${e.end}T00:00:00Z`);
  return `${s.toLocaleDateString('en-GB', opts)} – ${en.toLocaleDateString('en-GB', opts)} ${en.getUTCFullYear()}`;
};

const daysTo = (d: string) => Math.ceil((Date.parse(d) - now) / 86_400_000);
---

<Base
  title="Events"
  description="Conferences, trade fairs and award deadlines in architectural lighting."
>
  <PageHeader
    eyebrow="Calendar"
    viEyebrow="Lịch"
    title="Events"
    viTitle="Sự kiện"
    lede="Conferences, fairs and award deadlines. Every entry records the date its details were last checked and the source they came from, and an automated job re-tests each link weekly. Still confirm with the organiser before booking anything."
  >
    <p class="vi-block vi-def mt-2 text-[0.95rem] max-w-2xl leading-relaxed">
      Hội thảo, hội chợ và hạn nộp giải thưởng. Mục nào cũng ghi ngày kiểm tra gần nhất và nguồn
      thông tin; link được tự động kiểm tra lại mỗi tuần. Dù vậy, hãy xác nhận với ban tổ chức
      trước khi đặt vé hay đăng ký.
    </p>
  </PageHeader>

  <section aria-labelledby="upcoming-h" class="mb-12">
    <h2 id="upcoming-h" class="text-lg font-semibold mb-4">Upcoming<span class="vi-block-inline font-normal text-[0.9rem]" style="color: var(--vi-text)"> · Sắp diễn ra</span></h2>
    {
      upcoming.length === 0 ? (
        <p class="card p-6" style="color: var(--text-muted)">
          Nothing scheduled. Add entries to <code class="font-mono text-[0.85em]">src/content/events.json</code>.
          <span class="vi-block mt-1.5 text-[0.92rem]" style="color: var(--vi-text)">
            Chưa có sự kiện nào. Thêm sự kiện vào <code class="font-mono text-[0.85em]">src/content/events.json</code>.
          </span>
        </p>
      ) : (
        <div class="grid gap-3">
          {upcoming.map((e) => (
            <article class="card p-5 flex flex-wrap gap-x-6 gap-y-3 items-start">
              <div class="min-w-[7rem]">
                <p class="font-mono text-[0.85rem]" style="color: var(--accent)">
                  {range(e.data)}
                </p>
                <p class="text-[0.78rem] mt-0.5" style="color: var(--text-faint)">
                  in {daysTo(e.data.start)} days
                  <span class="vi-block" style="color: var(--vi-text)">còn {daysTo(e.data.start)} ngày</span>
                </p>
              </div>

              <div class="flex-1 min-w-[16rem]">
                <div class="flex items-baseline gap-2.5 flex-wrap">
                  <h3 class="font-semibold">
                    <a href={e.data.url} target="_blank" rel="noopener noreferrer" class="no-underline hover:underline" style="color: var(--text)">
                      {e.data.name}
                    </a>
                  </h3>
                  <span class="chip" style={kindStyle[e.data.kind]} title={viKind[e.data.kind]}>
                    {e.data.kind}
                  </span>
                </div>
                <p class="text-[0.85rem] mt-1" style="color: var(--text-muted)">
                  {e.data.venue ? `${e.data.venue} · ` : ''}{e.data.city}, {e.data.country}
                </p>
                {e.data.note && (
                  <p class="text-[0.87rem] mt-2 leading-relaxed" style="color: var(--text-muted)">
                    {e.data.note}
                  </p>
                )}
                {e.data.viNote && (
                  <p class="vi-block vi-def text-[0.84rem] mt-1.5 leading-relaxed">{e.data.viNote}</p>
                )}
                <p class="text-[0.72rem] mt-2.5" style="color: var(--text-faint)">
                  Dates and link checked {e.data.verified} · {e.data.source}
                  <span class="vi-block mt-0.5" style="color: var(--vi-text)">Ngày và link kiểm tra lần cuối: {e.data.verified}</span>
                </p>
              </div>
            </article>
          ))}
        </div>
      )
    }
  </section>

  {
    past.length > 0 && (
      <section aria-labelledby="past-h" class="pb-6">
        <h2 id="past-h" class="text-lg font-semibold mb-4" style="color: var(--text-muted)">
          Past
          <span class="vi-block-inline font-normal text-[0.9rem]" style="color: var(--vi-text)"> · Đã diễn ra</span>
        </h2>
        <div class="grid gap-2">
          {past.map((e) => (
            <div class="card px-4 py-3 flex flex-wrap items-baseline gap-x-4 gap-y-1 opacity-70">
              <span class="font-mono text-[0.82rem]" style="color: var(--text-faint)">
                {range(e.data)}
              </span>
              <a href={e.data.url} target="_blank" rel="noopener noreferrer" class="text-[0.92rem] no-underline hover:underline" style="color: var(--text-muted)">
                {e.data.name}
              </a>
              <span class="text-[0.8rem] ml-auto" style="color: var(--text-faint)">
                {e.data.city}
              </span>
            </div>
          ))}
        </div>
      </section>
    )
  }
</Base>
