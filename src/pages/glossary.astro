---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { TOPIC_LABEL } from '../site';

const terms = (await getCollection('glossary')).sort((a, b) =>
  a.data.term.localeCompare(b.data.term)
);
const byId = new Map(terms.map((t) => [t.id, t.data.term]));
const topics = [...new Set(terms.flatMap((t) => t.data.topics))].sort();
---

<Base
  title="Glossary"
  description="Working definitions of the photometric, colour, control and practice terms used in architectural lighting design."
>
  <PageHeader
    eyebrow={`${terms.length} terms`}
    title="Glossary"
    lede="Definitions written for use, not for exams — each one says what the term means and what it changes about a decision."
  >
    <p class="vi-block vi-def mt-2 text-[0.95rem] max-w-2xl leading-relaxed">
      Gõ một thuật ngữ tiếng Anh vào ô dưới để xem giải thích và ví dụ cụ thể bằng tiếng Việt.
      Tìm được cả bằng tiếng Việt — gõ “độ rọi” cũng ra.
    </p>
  </PageHeader>

  <div class="relative mb-5" data-pagefind-ignore>
    <svg
      class="absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none"
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="var(--text-faint)"
      stroke-width="2"
      stroke-linecap="round"
      aria-hidden="true"
    >
      <circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.5-3.5"></path>
    </svg>
    <input
      id="glossary-filter"
      type="search"
      placeholder="Tra thuật ngữ — ví dụ: UGR, illuminance, độ rọi…"
      data-ph-en="Look up a term — e.g. UGR, illuminance, glare…"
      class="field !py-3 !pl-11 !text-[1rem] w-full"
      aria-label="Tra cứu thuật ngữ"
      autocomplete="off"
    />
  </div>

  <div class="flex flex-wrap gap-2 mb-6 pb-6 border-b" style="border-color: var(--border)" data-pagefind-ignore>
    <button class="chip chip-accent filter-btn cursor-pointer" data-topic="all" type="button" aria-pressed="true">
      All
    </button>
    {
      topics.map((t) => (
        <button class="chip filter-btn cursor-pointer" data-topic={t} type="button" aria-pressed="false">
          {TOPIC_LABEL[t] ?? t}
        </button>
      ))
    }
  </div>

  <div class="grid md:grid-cols-2 gap-3 pb-6" id="glossary-list">
    {
      terms.map((t) => (
        <article
          class="card p-5 term-item scroll-mt-24"
          id={t.id}
          data-topics={t.data.topics.join(' ')}
          data-text={[
            t.data.term,
            t.data.vi,
            t.data.symbol,
            t.data.unit,
            t.data.definition,
            t.data.viDefinition,
            t.data.viNote,
            t.data.viExample,
          ]
            .filter(Boolean)
            .join(' ')
            .toLowerCase()}
        >
          <div class="flex items-baseline gap-2 flex-wrap">
            <h2 class="text-[1.08rem] font-semibold">{t.data.term}</h2>
            {t.data.symbol && (
              <span class="font-mono text-[0.8rem]" style="color: var(--accent)">
                {t.data.symbol}
              </span>
            )}
            {t.data.unit && (
              <span class="font-mono text-[0.75rem]" style="color: var(--text-faint)">
                {t.data.unit}
              </span>
            )}
          </div>

          {t.data.vi && (
            <p class="vi-block vi-term text-[0.83rem] mt-0.5 font-medium">{t.data.vi}</p>
          )}

          <p class="text-[0.92rem] mt-2.5 leading-relaxed" style="color: var(--text-muted)">
            {t.data.definition}
          </p>

          {t.data.viDefinition && (
            <p class="vi-block vi-def text-[0.89rem] mt-2 leading-relaxed">
              {t.data.viDefinition}
            </p>
          )}

          {t.data.note && (
            <p
              class="text-[0.87rem] mt-3 pl-3 border-l-2 leading-relaxed"
              style="border-color: var(--accent); color: var(--text-muted)"
            >
              {t.data.note}
            </p>
          )}

          {t.data.viNote && (
            <p class="vi-block vi-def text-[0.85rem] mt-2 leading-relaxed">{t.data.viNote}</p>
          )}

          {t.data.viExample && (
            <div
              class="vi-block mt-3 rounded-lg p-3"
              style="background: var(--bg-elevated); border: 1px solid var(--vi-rule)"
            >
              <p class="label !mb-1" style="color: var(--vi-text)">Ví dụ</p>
              <p class="text-[0.85rem] leading-[1.75]" style="color: var(--vi-text)">
                {t.data.viExample}
              </p>
            </div>
          )}

          {t.data.seeAlso.length > 0 && (
            <p class="text-[0.8rem] mt-3" style="color: var(--text-faint)">
              See also:{' '}
              {t.data.seeAlso
                .filter((s) => byId.has(s))
                .map((s, i, arr) => (
                  <>
                    <a href={`#${s}`} class="no-underline hover:underline">
                      {byId.get(s)}
                    </a>
                    {i < arr.length - 1 ? ', ' : ''}
                  </>
                ))}
            </p>
          )}
        </article>
      ))
    }
  </div>

  <div id="glossary-empty" class="hidden py-10 text-center">
    <p style="color: var(--text-faint)">No terms match that search.</p>
    <p class="vi-block vi-def mt-1 text-[0.88rem]">
      Không tìm thấy thuật ngữ nào. Thử gõ ngắn hơn, hoặc bỏ dấu tiếng Việt.
    </p>
  </div>
</Base>

<script>
  const items = [...document.querySelectorAll<HTMLElement>('.term-item')];
  const buttons = [...document.querySelectorAll<HTMLElement>('.filter-btn')];
  const input = document.getElementById('glossary-filter') as HTMLInputElement | null;
  const empty = document.getElementById('glossary-empty');

  let topic = 'all';

  /**
   * Strip Vietnamese diacritics so "do roi" finds "độ rọi". Typing tones is
   * slow, and on a phone most people simply do not bother — matching without
   * them is the difference between the lookup being used and not.
   */
  const fold = (s: string) =>
    s
      .normalize('NFD')
      .replace(/[̀-ͯ]/g, '')
      .replace(/đ/g, 'd')
      .replace(/Đ/g, 'D')
      .toLowerCase();

  // Precompute the folded haystack once, not on every keystroke.
  const folded = new WeakMap<HTMLElement, string>();
  for (const el of items) folded.set(el, fold(el.dataset.text ?? ''));

  function apply() {
    const raw = (input?.value ?? '').trim();
    const q = fold(raw);
    let shown = 0;
    for (const el of items) {
      const okTopic = topic === 'all' || (el.dataset.topics ?? '').split(' ').includes(topic);
      const okText = !q || (folded.get(el) ?? '').includes(q);
      const show = okTopic && okText;
      el.classList.toggle('hidden', !show);
      if (show) shown++;
    }
    empty?.classList.toggle('hidden', shown > 0);
  }

  buttons.forEach((btn) =>
    btn.addEventListener('click', () => {
      topic = btn.dataset.topic!;
      buttons.forEach((b) => {
        const on = b === btn;
        b.classList.toggle('chip-accent', on);
        b.setAttribute('aria-pressed', String(on));
      });
      apply();
    })
  );

  input?.addEventListener('input', apply);

  // Deep links from the "term of the day" card should highlight the target.
  if (location.hash) {
    document.querySelector(location.hash)?.classList.add('ring-2');
  }
</script>
