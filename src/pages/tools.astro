---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { url } from '../site';
---

<Base
  title="Tools"
  description="Lumen method, beam-to-spot, inverse square law, melanopic EDI and unit conversion — calculators that run entirely in the browser."
>
  <PageHeader
    eyebrow="Calculators"
    viEyebrow="Máy tính"
    title="Tools"
    viTitle="Công cụ"
    lede="Everything runs in your browser by default — your inputs and images stay on your machine, unless you opt into a cloud AI engine with your own key. For sketching and sanity checks, not for certification."
  >
    <p class="vi-block vi-def mt-2 text-[0.95rem] max-w-2xl leading-relaxed">
      Mặc định mọi thứ chạy ngay trong trình duyệt, số liệu và ảnh của bạn không rời khỏi máy, trừ
      khi bạn tự chọn engine AI đám mây bằng key riêng. Dùng để tính phác và kiểm tra nhanh, không
      thay cho phần mềm tính toán chính thức.
    </p>
  </PageHeader>

  <div class="grid gap-5 pb-6">
    <!-- ---------------------------------------- render segmentation -->
    <a
      href={url('/tools/segment')}
      class="card p-6 no-underline block card-interactive"
      style="color: var(--text); border-color: color-mix(in srgb, var(--accent-cool) 40%, transparent)"
    >
      <div class="flex items-baseline gap-2 flex-wrap">
        <h2 class="text-lg font-semibold">Segment a render for lighting<span class="vi-block-inline"> · Tách vùng ảnh render cho chiếu sáng</span></h2>
        <span class="chip chip-accent">Beta</span>
        <span class="ml-auto text-[0.85rem]" style="color: var(--accent-cool)">Open →<span class="vi-block-inline"> · Mở</span></span>
      </div>
      <p class="text-[0.9rem] mt-1.5" style="color: var(--text-muted)">
        Turn a render into per-object and per-wall-plane selection masks for the lighting pass, so
        you can grade each surface individually in post. Free in-browser engine, or cloud AI
        (Gemini / GPT) with your own key for cleaner masks.
      </p>
      <p class="vi-block vi-def text-[0.86rem] mt-1.5">
        Tách ảnh render thành mask cho từng vật thể và từng mảng tường, để khi hậu kỳ bạn chỉnh sáng
        riêng cho từng bề mặt. Dùng engine miễn phí ngay trong trình duyệt, hoặc AI đám mây
        (Gemini / GPT) bằng key riêng để mask sạch hơn.
      </p>
    </a>

    <!-- ------------------------------------------------ lumen method -->
    <section id="lumen" class="card p-6 scroll-mt-20" aria-labelledby="lumen-h">
      <h2 id="lumen-h" class="text-lg font-semibold">Lumen method<span class="vi-block-inline"> · Phương pháp quang thông</span></h2>
      <p class="text-[0.9rem] mt-1.5" style="color: var(--text-muted)">
        Total flux needed for a target maintained illuminance, and the number of luminaires that
        implies. Room index is computed from the geometry.
      </p>
      <p class="vi-block vi-def text-[0.86rem] mt-1 mb-5">Tính tổng quang thông cần để đạt độ rọi duy trì mong muốn, từ đó ra số bộ đèn. Chỉ số phòng tự tính theo kích thước phòng.</p>

      <div class="grid sm:grid-cols-3 gap-4">
        <div><label class="label" for="lm-L">Room length (m)<span class="vi-block-inline"> · Chiều dài phòng (m)</span></label><input class="field" id="lm-L" type="number" value="10" step="0.1" min="0.1" /></div>
        <div><label class="label" for="lm-W">Room width (m)<span class="vi-block-inline"> · Chiều rộng phòng (m)</span></label><input class="field" id="lm-W" type="number" value="8" step="0.1" min="0.1" /></div>
        <div><label class="label" for="lm-H">Mounting ht above plane (m)<span class="vi-block-inline"> · Độ cao đèn so với mặt làm việc (m)</span></label><input class="field" id="lm-H" type="number" value="2.0" step="0.1" min="0.1" /></div>
        <div><label class="label" for="lm-E">Target Ēm (lx)<span class="vi-block-inline"> · Độ rọi duy trì cần đạt Ēm (lx)</span></label><input class="field" id="lm-E" type="number" value="500" step="10" min="1" /></div>
        <div><label class="label" for="lm-UF">Utilisation factor<span class="vi-block-inline"> · Hệ số sử dụng (UF)</span></label><input class="field" id="lm-UF" type="number" value="0.60" step="0.01" min="0.05" max="1" /></div>
        <div><label class="label" for="lm-MF">Maintenance factor<span class="vi-block-inline"> · Hệ số duy trì (MF)</span></label><input class="field" id="lm-MF" type="number" value="0.80" step="0.01" min="0.05" max="1" /></div>
        <div class="sm:col-span-3"><label class="label" for="lm-lum">Flux per luminaire (lm)<span class="vi-block-inline"> · Quang thông mỗi bộ đèn (lm)</span></label><input class="field" id="lm-lum" type="number" value="3000" step="100" min="1" /></div>
      </div>

      <div class="grid sm:grid-cols-4 gap-3 mt-5" id="lm-out"></div>
      <p class="text-[0.8rem] mt-4" style="color: var(--text-faint)">
        Utilisation factor comes from the manufacturer's UF table for your room index and surface
        reflectances. 0.4 is a reasonable guess for a dark room with narrow optics, 0.7 for a
        bright room with wide ones. This method gives an average only — it says nothing about
        uniformity or glare.
      </p>
      <p class="vi-block vi-def text-[0.78rem] mt-1.5">Hệ số sử dụng tra trong bảng UF của nhà sản xuất, theo chỉ số phòng và hệ số phản xạ các bề mặt. Phòng tối dùng đèn chùm hẹp thì lấy khoảng 0.4, phòng sáng dùng đèn chùm rộng khoảng 0.7. Phương pháp này chỉ cho độ rọi trung bình, không cho biết gì về độ đồng đều hay chói loá.</p>
    </section>

    <!-- ------------------------------------------------- beam to spot -->
    <section id="beam" class="card p-6 scroll-mt-20" aria-labelledby="beam-h">
      <h2 id="beam-h" class="text-lg font-semibold">Beam angle → spot size<span class="vi-block-inline"> · Góc chiếu → kích thước vệt sáng</span></h2>
      <p class="text-[0.9rem] mt-1.5" style="color: var(--text-muted)">
        Pool diameter at a given throw, and the peak intensity needed to hit a target illuminance
        on axis.
      </p>
      <p class="vi-block vi-def text-[0.86rem] mt-1 mb-5">Đường kính vệt sáng ở khoảng cách chiếu cho trước, và cường độ sáng tâm chùm cần có để đạt độ rọi mong muốn trên trục.</p>

      <div class="grid sm:grid-cols-3 gap-4">
        <div><label class="label" for="bs-d">Throw distance (m)<span class="vi-block-inline"> · Khoảng cách chiếu (m)</span></label><input class="field" id="bs-d" type="number" value="3.25" step="0.05" min="0.1" /></div>
        <div><label class="label" for="bs-a">Beam angle (°)<span class="vi-block-inline"> · Góc chiếu (°)</span></label><input class="field" id="bs-a" type="number" value="36" step="1" min="1" max="170" /></div>
        <div><label class="label" for="bs-E">Target E on axis (lx)<span class="vi-block-inline"> · Độ rọi mục tiêu trên trục (lx)</span></label><input class="field" id="bs-E" type="number" value="300" step="10" min="1" /></div>
      </div>

      <div class="grid sm:grid-cols-3 gap-3 mt-5" id="bs-out"></div>

      <!-- Live section drawing; redraws on every input change. -->
      <div
        class="mt-5 rounded-lg p-3"
        style="background: var(--bg); border: 1px solid var(--border)"
      >
        <svg
          id="bs-svg"
          viewBox="0 0 560 300"
          role="img"
          aria-label="Live section drawing of the beam"
          style="display:block;width:100%;height:auto;font-family:var(--font-sans)"
        >
          <defs>
            <linearGradient id="live-cone" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="var(--accent)" stop-opacity="0.45" />
              <stop offset="100%" stop-color="var(--accent)" stop-opacity="0.06" />
            </linearGradient>
            <radialGradient id="live-pool" cx="0.5" cy="0.5" r="0.5">
              <stop offset="0%" stop-color="var(--accent)" stop-opacity="0.6" />
              <stop offset="70%" stop-color="var(--accent)" stop-opacity="0.2" />
              <stop offset="100%" stop-color="var(--accent)" stop-opacity="0" />
            </radialGradient>
          </defs>
          <g id="bs-draw"></g>
        </svg>
      </div>

      <div class="mt-5 scroll-x">
        <table class="datatable">
          <caption class="sr-only">Spot diameter by beam angle at the entered throw distance</caption>
          <thead><tr><th scope="col">Beam<span class="vi-block-inline"> · Góc</span></th><th scope="col">Diameter<span class="vi-block-inline"> · Đường kính</span></th><th scope="col">Typical use<span class="vi-block-inline"> · Ứng dụng điển hình</span></th></tr></thead>
          <tbody id="bs-table"></tbody>
        </table>
      </div>
    </section>

    <!-- ------------------------------------------- inverse square law -->
    <section id="isl" class="card p-6 scroll-mt-20" aria-labelledby="isl-h">
      <h2 id="isl-h" class="text-lg font-semibold">Inverse square law<span class="vi-block-inline"> · Định luật nghịch đảo bình phương</span></h2>
      <p class="text-[0.9rem] mt-1.5" style="color: var(--text-muted)">
        E = I · cos θ / d². Also converts illuminance to luminance for a matte surface, which is
        what the eye actually sees.
      </p>
      <p class="vi-block vi-def text-[0.86rem] mt-1 mb-5">E = I · cos θ / d². Công cụ cũng đổi độ rọi ra độ chói của bề mặt mờ, vì độ chói mới là cái mắt thật sự nhìn thấy.</p>

      <div class="grid sm:grid-cols-4 gap-4">
        <div><label class="label" for="isl-I">Intensity (cd)<span class="vi-block-inline"> · Cường độ sáng (cd)</span></label><input class="field" id="isl-I" type="number" value="5000" step="100" min="0" /></div>
        <div><label class="label" for="isl-d">Distance (m)<span class="vi-block-inline"> · Khoảng cách (m)</span></label><input class="field" id="isl-d" type="number" value="4" step="0.1" min="0.05" /></div>
        <div><label class="label" for="isl-t">Incidence angle θ (°)<span class="vi-block-inline"> · Góc tới θ (°)</span></label><input class="field" id="isl-t" type="number" value="0" step="5" min="0" max="89" /></div>
        <div><label class="label" for="isl-r">Surface reflectance ρ<span class="vi-block-inline"> · Hệ số phản xạ bề mặt ρ</span></label><input class="field" id="isl-r" type="number" value="0.7" step="0.05" min="0" max="1" /></div>
      </div>

      <div class="grid sm:grid-cols-3 gap-3 mt-5" id="isl-out"></div>
      <p class="text-[0.8rem] mt-4" style="color: var(--text-faint)">
        Valid only when the distance is at least about five times the largest luminaire dimension.
        Do not use it close to a long linear fitting.
      </p>
      <p class="vi-block vi-def text-[0.78rem] mt-1.5">Chỉ đúng khi khoảng cách lớn hơn khoảng năm lần kích thước lớn nhất của bộ đèn. Không áp dụng khi đứng sát một dải đèn tuyến tính dài.</p>
    </section>

    <!-- -------------------------------------------------- melanopic -->
    <section id="medi" class="card p-6 scroll-mt-20" aria-labelledby="medi-h">
      <h2 id="medi-h" class="text-lg font-semibold">Melanopic EDI<span class="vi-block-inline"> · Melanopic EDI (độ rọi tương đương ánh sáng ngày)</span></h2>
      <p class="text-[0.9rem] mt-1.5" style="color: var(--text-muted)">
        Vertical photopic lux at the eye × M-DER. Checked against the widely cited consensus
        targets.
      </p>
      <p class="vi-block vi-def text-[0.86rem] mt-1 mb-5">Độ rọi đứng tại mắt × M-DER, rồi so với ngưỡng khuyến nghị được dùng rộng rãi: ban ngày ≥250, buổi tối ≤10.</p>

      <div class="grid sm:grid-cols-3 gap-4">
        <div>
          <label class="label" for="me-E">Vertical lux at eye<span class="vi-block-inline"> · Độ rọi đứng tại mắt (lx)</span></label>
          <input class="field" id="me-E" type="number" value="300" step="10" min="0" />
        </div>
        <div>
          <label class="label" for="me-cct">Source CCT<span class="vi-block-inline"> · CCT của nguồn sáng</span></label>
          <select class="field" id="me-cct">
            <option value="0.35">2200 K</option>
            <option value="0.45">2700 K</option>
            <option value="0.52" selected>3000 K</option>
            <option value="0.65">3500 K</option>
            <option value="0.75">4000 K</option>
            <option value="0.90">5000 K</option>
            <option value="1.00">6500 K / D65</option>
            <option value="custom">Custom M-DER… / Tự nhập M-DER…</option>
          </select>
        </div>
        <div>
          <label class="label" for="me-mder">M-DER</label>
          <input class="field" id="me-mder" type="number" value="0.52" step="0.01" min="0" max="1.5" />
        </div>
      </div>

      <div class="grid sm:grid-cols-2 gap-3 mt-5" id="me-out"></div>
      <p class="text-[0.8rem] mt-4" style="color: var(--text-faint)">
        M-DER values here are typical for phosphor-converted white LEDs. For a real specification,
        take M-DER from the manufacturer's spectral data via the CIE S 026 toolbox — two products
        at the same CCT can differ by 15% or more.
        <a href={url('/learn/circadian-design')} class="no-underline hover:underline">Read the article →<span class="vi-block-inline"> · Đọc bài viết</span></a>
      </p>
      <p class="vi-block vi-def text-[0.78rem] mt-1.5">Giá trị M-DER ở đây là mức điển hình của LED trắng phủ phosphor. Khi làm spec thật, hãy lấy M-DER từ dữ liệu phổ của nhà sản xuất qua bộ công cụ CIE S 026, vì hai sản phẩm cùng CCT có thể lệch nhau từ 15% trở lên.</p>
    </section>

    <!-- ---------------------------------------------------- converter -->
    <section id="convert" class="card p-6 scroll-mt-20" aria-labelledby="conv-h">
      <h2 id="conv-h" class="text-lg font-semibold">Unit converter<span class="vi-block-inline"> · Đổi đơn vị</span></h2>
      <p class="text-[0.9rem] mt-1.5" style="color: var(--text-muted)">
        The conversions that come up when a drawing set arrives in the other convention.
      </p>
      <p class="vi-block vi-def text-[0.86rem] mt-1 mb-5">Những phép đổi hay cần khi nhận bộ hồ sơ dùng hệ đơn vị Bắc Mỹ (footcandle, foot-lambert).</p>
      <div class="grid sm:grid-cols-2 gap-4">
        <div><label class="label" for="cv-fc">Footcandles</label><input class="field" id="cv-fc" type="number" value="50" step="1" /></div>
        <div><label class="label" for="cv-lx">Lux</label><input class="field" id="cv-lx" type="number" value="538" step="1" /></div>
        <div><label class="label" for="cv-fl">Foot-lamberts</label><input class="field" id="cv-fl" type="number" value="10" step="1" /></div>
        <div><label class="label" for="cv-nit">cd/m² (nits)</label><input class="field" id="cv-nit" type="number" value="34.3" step="0.1" /></div>
      </div>
      <p class="text-[0.8rem] mt-4" style="color: var(--text-faint)">
        1 fc = 10.764 lx · 1 fL = 3.426 cd/m²
      </p>
    </section>
  </div>
</Base>

<script>
  // ---------------------------------------------------------------- helpers
  const $ = <T extends HTMLElement = HTMLInputElement>(id: string) =>
    document.getElementById(id) as T | null;
  const num = (id: string) => Number(($(id) as HTMLInputElement | null)?.value ?? 0);

  /** English + Vietnamese; the site's EN/VI switch shows one of them. */
  const bi = (en: string, vi: string) => `${en}<span class="vi-block-inline"> · ${vi}</span>`;

  /** Result tile. `tone` colours the value for pass/fail readouts. */
  function tile(label: string, value: string, sub = '', tone = '') {
    return `<div class="rounded-lg p-3" style="background: var(--bg-elevated); border: 1px solid var(--border)">
      <p class="label !mb-1">${label}</p>
      <p class="font-mono text-xl" style="color: ${tone || 'var(--accent)'}">${value}</p>
      ${sub ? `<p class="text-[0.75rem] mt-0.5" style="color: var(--text-faint)">${sub}</p>` : ''}
    </div>`;
  }

  const fmt = (n: number, d = 0) =>
    Number.isFinite(n)
      ? n.toLocaleString('en-GB', { minimumFractionDigits: d, maximumFractionDigits: d })
      : '—';

  function bind(ids: string[], fn: () => void) {
    ids.forEach((id) => {
      const el = $(id);
      el?.addEventListener('input', fn);
      el?.addEventListener('change', fn);
    });
    fn();
  }

  // ------------------------------------------------------------ lumen method
  bind(['lm-L', 'lm-W', 'lm-H', 'lm-E', 'lm-UF', 'lm-MF', 'lm-lum'], () => {
    const L = num('lm-L'), W = num('lm-W'), H = num('lm-H');
    const E = num('lm-E'), UF = num('lm-UF'), MF = num('lm-MF'), lum = num('lm-lum');

    const area = L * W;
    const K = (L * W) / (H * (L + W));           // room index
    const totalFlux = (E * area) / (UF * MF);
    const count = totalFlux / lum;
    const nUp = Math.ceil(count);
    const achieved = (nUp * lum * UF * MF) / area;

    const out = $('lm-out');
    if (out)
      out.innerHTML =
        tile(bi('Floor area', 'Diện tích sàn'), `${fmt(area, 1)} m²`) +
        tile(bi('Room index K', 'Chỉ số phòng K'), fmt(K, 2), K < 0.75 ? bi('narrow room', 'phòng hẹp') : K > 3 ? bi('wide room', 'phòng rộng') : bi('typical', 'điển hình')) +
        tile(bi('Total flux required', 'Tổng quang thông cần có'), `${fmt(totalFlux)} lm`) +
        tile(bi('Luminaires', 'Số bộ đèn'), `${fmt(nUp)}`, bi(`${fmt(achieved)} lx achieved`, `đạt ${fmt(achieved)} lx`));
  });

  // ------------------------------------------------------------ beam to spot
  const BEAMS = [
    [10, bi('Object accent, single sculpture', 'Nhấn một vật thể, tượng đơn')],
    [15, bi('Artwork, table centre', 'Tranh, tâm bàn ăn')],
    [24, bi('General accent, seating group', 'Nhấn sáng chung, cụm sofa')],
    [36, bi('Wide accent, circulation', 'Nhấn sáng rộng, lối đi')],
    [60, bi('General downlight', 'Downlight chiếu chung')],
    [90, bi('Wall wash, broad ambient', 'Wash tường, sáng nền diện rộng')],
  ] as const;

  bind(['bs-d', 'bs-a', 'bs-E'], () => {
    const d = num('bs-d'), a = num('bs-a'), E = num('bs-E');
    const dia = 2 * d * Math.tan((a * Math.PI) / 180 / 2);
    const I = E * d * d;

    const out = $('bs-out');
    if (out)
      out.innerHTML =
        tile(bi('Spot diameter', 'Đường kính vệt sáng'), `${fmt(dia, 2)} m`, bi(`at ${fmt(d, 2)} m throw`, `ở khoảng chiếu ${fmt(d, 2)} m`)) +
        tile(bi('Lit area', 'Diện tích vệt sáng'), `${fmt(Math.PI * (dia / 2) ** 2, 2)} m²`) +
        tile(bi('Peak intensity needed', 'Cường độ đỉnh cần có'), `${fmt(I)} cd`, bi(`for ${fmt(E)} lx on axis`, `để đạt ${fmt(E)} lx trên trục`));

    const tbl = $('bs-table');
    if (tbl)
      tbl.innerHTML = BEAMS.map(
        ([deg, use]) =>
          `<tr><td class="num">${deg}°</td><td class="num" style="color: var(--accent)">${fmt(
            2 * d * Math.tan((deg * Math.PI) / 180 / 2),
            2
          )} m</td><td style="color: var(--text-muted)">${use}</td></tr>`
      ).join('');

    drawBeam(d, a, dia, I, E);
  });

  /** Redraws the section under the beam calculator from the current inputs. */
  function drawBeam(d: number, a: number, dia: number, I: number, E: number) {
    const g = document.getElementById('bs-draw');
    if (!g) return;

    const W = 560, FX = W / 2, FY = 40, FLOOR = 244;
    const rad = (deg: number) => (deg * Math.PI) / 180;

    // The drawing scales to fit whichever is more extreme, the throw or the spread,
    // so the geometry stays legible from a 0.5 m throw to a 20 m one.
    const halfBeam = Math.tan(rad(Math.min(a, 170)) / 2) * (FLOOR - FY);
    const fit = Math.min(1, (W / 2 - 78) / Math.max(halfBeam, 1));
    const hb = halfBeam * fit;
    const hf = Math.min(Math.tan(rad(Math.min(a * 1.55, 178)) / 2) * (FLOOR - FY) * fit, W / 2 - 46);

    const label = (x: number, y: number, t: string, cls = 'lbl', anchor = 'middle') =>
      `<text x="${x}" y="${y}" text-anchor="${anchor}" class="${cls}">${t}</text>`;

    g.innerHTML = `
      <style>
        .lbl { font-size: 10px; fill: var(--text-faint); font-family: var(--font-mono) }
        .lbl-a { font-size: 11px; fill: var(--accent); font-family: var(--font-mono); font-weight: 500 }
        .ln { stroke: var(--border-strong); fill: none; stroke-width: 1 }
        .sl { stroke: var(--text-muted); fill: none; stroke-width: 1.4 }
        .bm { stroke: var(--accent); fill: none; stroke-width: 1.6 }
        .dsh { stroke: var(--border-strong); fill: none; stroke-width: 1; stroke-dasharray: 3 3 }
      </style>

      <line class="sl" x1="40" y1="${FY}" x2="${W - 40}" y2="${FY}"/>
      ${label(44, FY - 8, 'ceiling', 'lbl', 'start')}

      <path d="M ${FX} ${FY} L ${FX - hf} ${FLOOR} L ${FX + hf} ${FLOOR} Z"
            fill="var(--accent)" fill-opacity="0.08"/>
      <path d="M ${FX} ${FY} L ${FX - hb} ${FLOOR} L ${FX + hb} ${FLOOR} Z" fill="url(#live-cone)"/>
      <line class="bm" x1="${FX}" y1="${FY}" x2="${FX - hb}" y2="${FLOOR}"/>
      <line class="bm" x1="${FX}" y1="${FY}" x2="${FX + hb}" y2="${FLOOR}"/>
      <line class="dsh" x1="${FX}" y1="${FY}" x2="${FX}" y2="${FLOOR}"/>

      <rect x="${FX - 17}" y="${FY - 11}" width="34" height="11" rx="2"
            fill="var(--surface)" stroke="var(--border-strong)"/>
      <circle cx="${FX}" cy="${FY + 1}" r="3.4" fill="var(--accent)"/>

      <path class="bm" stroke-width="1.2"
            d="M ${FX - Math.tan(rad(Math.min(a, 170)) / 2) * 64} ${FY + 64}
               A 64 64 0 0 0 ${FX + Math.tan(rad(Math.min(a, 170)) / 2) * 64} ${FY + 64}"/>
      ${label(FX, FY + 86, a.toFixed(0) + '&#176;', 'lbl-a')}

      <ellipse cx="${FX}" cy="${FLOOR}" rx="${hb}" ry="12" fill="url(#live-pool)"/>
      <line class="sl" x1="40" y1="${FLOOR}" x2="${W - 40}" y2="${FLOOR}"/>

      <line class="ln" x1="${FX + hf + 30}" y1="${FY}" x2="${FX + hf + 30}" y2="${FLOOR}"/>
      <line class="ln" x1="${FX + hf + 25}" y1="${FY}" x2="${FX + hf + 35}" y2="${FY}"/>
      <line class="ln" x1="${FX + hf + 25}" y1="${FLOOR}" x2="${FX + hf + 35}" y2="${FLOOR}"/>
      <text x="${FX + hf + 40}" y="${(FY + FLOOR) / 2}" class="lbl" text-anchor="middle"
            transform="rotate(-90 ${FX + hf + 40} ${(FY + FLOOR) / 2})">${fmt(d, 2)} m throw</text>

      <line class="ln" x1="${FX - hb}" y1="${FLOOR + 26}" x2="${FX + hb}" y2="${FLOOR + 26}"/>
      <line class="ln" x1="${FX - hb}" y1="${FLOOR + 21}" x2="${FX - hb}" y2="${FLOOR + 31}"/>
      <line class="ln" x1="${FX + hb}" y1="${FLOOR + 21}" x2="${FX + hb}" y2="${FLOOR + 31}"/>
      ${label(FX, FLOOR + 44, '&#216; ' + fmt(dia, 2) + ' m', 'lbl-a')}

      ${label(FX - hb - 8, FLOOR - 8, fmt(E) + ' lx', 'lbl', 'end')}
      ${label(FX + hb + 8, FLOOR - 8, fmt(I) + ' cd needed', 'lbl', 'start')}
      ${fit < 1 ? label(46, FLOOR + 44, 'drawing scaled to fit', 'lbl', 'start') : ''}
    `;
  }

  // ------------------------------------------------------ inverse square law
  bind(['isl-I', 'isl-d', 'isl-t', 'isl-r'], () => {
    const I = num('isl-I'), d = num('isl-d'), t = num('isl-t'), r = num('isl-r');
    const E = (I * Math.cos((t * Math.PI) / 180)) / (d * d);
    const Lum = (E * r) / Math.PI;

    const out = $('isl-out');
    if (out)
      out.innerHTML =
        tile(bi('Illuminance', 'Độ rọi'), `${fmt(E, 1)} lx`, t > 0 ? bi(`with cos ${t}° = ${fmt(Math.cos((t * Math.PI) / 180), 3)}`, `với cos ${t}° = ${fmt(Math.cos((t * Math.PI) / 180), 3)}`) : bi('normal incidence', 'chiếu vuông góc')) +
        tile(bi('Luminance', 'Độ chói'), `${fmt(Lum, 1)} cd/m²`, bi(`matte surface, ρ = ${r}`, `bề mặt mờ, ρ = ${r}`)) +
        tile(bi('At double distance', 'Ở khoảng cách gấp đôi'), `${fmt(E / 4, 1)} lx`, bi('25% of the value', 'chỉ còn 25%'));
  });

  // ---------------------------------------------------------------- melanopic
  const cctSel = $<HTMLSelectElement>('me-cct');
  cctSel?.addEventListener('change', () => {
    if (cctSel.value !== 'custom') {
      ($('me-mder') as HTMLInputElement).value = cctSel.value;
      ($('me-mder') as HTMLInputElement).dispatchEvent(new Event('input'));
    }
  });

  bind(['me-E', 'me-mder', 'me-cct'], () => {
    const E = num('me-E'), mder = num('me-mder');
    const medi = E * mder;

    let verdict: string, tone: string;
    if (medi >= 250) {
      verdict = bi('Meets the ≥250 lx daytime target', 'Đạt ngưỡng ban ngày ≥250 lx');
      tone = 'var(--success)';
    } else if (medi >= 150) {
      verdict = bi('Below the 250 lx daytime target', 'Dưới ngưỡng ban ngày 250 lx');
      tone = 'var(--warning)';
    } else if (medi <= 10) {
      verdict = bi('Within the ≤10 lx evening target', 'Trong ngưỡng buổi tối ≤10 lx');
      tone = 'var(--success)';
    } else {
      verdict = bi('Well below daytime target; too bright for evening', 'Thấp hơn nhiều so với ngưỡng ban ngày, nhưng quá sáng cho buổi tối');
      tone = 'var(--danger)';
    }

    const need = mder > 0 ? 250 / mder : Infinity;
    const out = $('me-out');
    if (out)
      out.innerHTML =
        tile('Melanopic EDI', `${fmt(medi)} lx`, verdict, tone) +
        tile(bi('Vertical lux for 250 mEDI', 'Độ rọi đứng để đạt 250 mEDI'), `${fmt(need)} lx`, bi('at this spectrum', 'với phổ này'));
  });

  // ---------------------------------------------------------------- converter
  const FC = 10.7639, FL = 3.42626;
  let guard = false;
  const link = (from: string, to: string, f: (v: number) => number) => {
    $(from)?.addEventListener('input', () => {
      if (guard) return;
      guard = true;
      ($(to) as HTMLInputElement).value = String(
        Math.round(f(num(from)) * 1000) / 1000
      );
      guard = false;
    });
  };
  link('cv-fc', 'cv-lx', (v) => v * FC);
  link('cv-lx', 'cv-fc', (v) => v / FC);
  link('cv-fl', 'cv-nit', (v) => v * FL);
  link('cv-nit', 'cv-fl', (v) => v / FL);
</script>
