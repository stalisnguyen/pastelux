---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import { url } from '../../site';
---

<Base
  title="Segment a render for lighting"
  description="Separate a render into per-object and per-wall-plane selection masks for lighting work in post — light each region individually. Runs entirely in your browser."
>
  <PageHeader
    eyebrow="Tools · Beta"
    title="Segment a render for lighting"
    lede="For the lighting pass in post-production. Upload a render and the tool separates it into solid flat-colour regions — each object, and each wall plane — so you can select and light each one individually in Photoshop, the way you would light them in the scene. Then you download the mask. It runs entirely in your browser; the image is never uploaded."
  >
    <p class="vi-block vi-def mt-2 text-[0.95rem] max-w-2xl leading-relaxed">
      Dành cho khâu chỉnh sáng hậu kỳ. Tải lên một ảnh render, công cụ tách thành các vùng màu phẳng
      đặc — từng vật thể, và từng mảng tường theo hướng — để bạn chọn và chiếu sáng riêng từng vùng
      trong Photoshop, đúng như cách bạn xử lý ánh sáng trong scene. Rồi tải mặt nạ về. Mọi thứ chạy
      ngay trong trình duyệt, ảnh không gửi đi đâu.
    </p>
  </PageHeader>

  <div
    class="card p-4 mb-6 text-[0.88rem] leading-relaxed max-w-3xl"
    style="border-color: color-mix(in srgb, var(--warning) 40%, transparent)"
  >
    <strong style="color: var(--warning)">What it gives you, and where it stops.</strong>
    <span style="color: var(--text-muted)">
      It turns the render into masks for a lighting pass: each object separated, and each wall plane
      split by orientation, so you can grade the light on every surface independently — a wall
      grazed here, an accent lifted there. The regions are lighting-independent: a shadow or a bright
      hotspot does not break an object into pieces. It is a geometric approximation, not a V-Ray
      object pass — very thin elements such as a slim light strip, and small distant objects, may
      still be missed; switch the model to <em>Detailed</em> for those.
    </span>
    <p class="vi-block vi-def mt-2">
      Công cụ biến ảnh render thành mặt nạ cho khâu chỉnh sáng: tách riêng từng vật, và chia mỗi mảng
      tường theo hướng, để bạn chỉnh ánh sáng riêng cho từng bề mặt — chỗ này rửa tường, chỗ kia nhấn
      sáng. Các vùng không phụ thuộc ánh sáng: một vệt bóng hay điểm sáng chói không làm vỡ một vật
      thành nhiều mảnh. Đây là xấp xỉ hình học, không phải VRay object pass — vật rất mảnh (ống đèn)
      hoặc vật nhỏ ở xa vẫn có thể bị bỏ sót; chuyển sang model <em>Detailed</em> để bắt tốt hơn.
    </p>
  </div>

  <!-- ======================================= step 1 -->
  <section class="card p-6 mb-4" aria-labelledby="s1">
    <div class="flex items-baseline gap-2 mb-3">
      <span class="chip chip-accent">1</span>
      <h2 id="s1" class="text-lg font-semibold">Upload the render</h2>
      <span class="vi-block-inline text-[0.9rem]" style="color: var(--vi-text)">Tải ảnh lên</span>
    </div>

    <label
      id="drop"
      class="block rounded-xl border-2 border-dashed cursor-pointer text-center py-10 px-4 transition-colors"
      style="border-color: var(--border-strong); background: var(--bg-elevated)"
    >
      <input id="file" type="file" accept="image/jpeg,image/png,image/webp" class="sr-only" />
      <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="var(--text-faint)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="mx-auto mb-3" aria-hidden="true">
        <path d="M4 16v2a2 2 0 002 2h12a2 2 0 002-2v-2" /><path d="M12 15V3M7 8l5-5 5 5" />
      </svg>
      <p class="font-medium">Drop a JPEG or PNG here, or click to choose</p>
      <p class="vi-block vi-def text-[0.85rem] mt-1" style="border:0;padding:0">
        Kéo thả ảnh JPEG/PNG vào đây, hoặc bấm để chọn file
      </p>
    </label>
  </section>

  <!-- ======================================= step 1b: clean logos (optional) -->
  <section id="cleanWrap" class="card p-6 mb-4 hidden" aria-labelledby="s1b">
    <div class="flex items-baseline gap-2 mb-3 flex-wrap">
      <span class="chip">1b</span>
      <h2 id="s1b" class="text-lg font-semibold">Remove text or logos <span class="text-[0.8rem] font-normal" style="color: var(--text-faint)">(optional)</span></h2>
      <span class="vi-block-inline text-[0.9rem]" style="color: var(--vi-text)">Xoá chữ / logo (không bắt buộc)</span>
    </div>
    <p class="text-[0.88rem] mb-1" style="color: var(--text-muted)">
      Brush over any watermark or text, then Apply — the area is filled from its surroundings.
      Works well on flat areas (walls, grass, sky); on busy texture the fill will look soft.
    </p>
    <p class="vi-block vi-def text-[0.85rem] mb-3">
      Quét chổi lên phần chữ hoặc logo rồi bấm Apply — vùng đó được lấp lại từ xung quanh. Hiệu quả
      tốt trên nền phẳng (tường, cỏ, trời); trên vân phức tạp chỗ lấp sẽ hơi mềm.
    </p>
    <div class="flex flex-wrap items-center gap-x-5 gap-y-2 mb-3 text-[0.9rem]">
      <label class="flex items-center gap-2">
        <span>Brush</span><span class="vi-block-inline" style="color: var(--vi-text)">· Cỡ chổi</span>
        <input id="brushSize" type="range" min="6" max="80" value="24" class="accent-[var(--accent)]" />
      </label>
      <button id="applyClean" class="btn btn-primary !py-1.5" type="button">Apply</button>
      <button id="resetClean" class="btn !py-1.5" type="button">Reset</button>
      <button id="dlClean" class="btn !py-1.5 hidden" type="button">Download cleaned image</button>
    </div>
    <div class="rounded-lg overflow-hidden" style="background: var(--bg)">
      <canvas id="cleanCanvas" class="block w-full h-auto" style="cursor: crosshair; touch-action: none"></canvas>
    </div>
  </section>

  <!-- ======================================= step 2 -->
  <section id="s2wrap" class="card p-6 mb-4 hidden" aria-labelledby="s2">
    <div class="flex items-baseline gap-2 mb-3 flex-wrap">
      <span class="chip chip-accent">2</span>
      <h2 id="s2" class="text-lg font-semibold">Segment</h2>
      <span class="vi-block-inline text-[0.9rem]" style="color: var(--vi-text)">Tách vùng</span>
      <button id="run" class="btn btn-primary ml-auto" type="button">Segment</button>
    </div>

    <!-- options -->
    <div class="flex flex-wrap items-center gap-x-6 gap-y-3 mb-4 text-[0.9rem]">
      <label class="flex items-center gap-2 cursor-pointer">
        <input id="splitPlanes" type="checkbox" class="accent-[var(--accent)]" checked />
        <span>Split wall planes</span>
        <span class="vi-block-inline" style="color: var(--vi-text)">· Tách mảng tường</span>
      </label>
      <span class="text-[0.8rem]" style="color: var(--text-faint)">
        Runs at maximum detail: the full frame plus four overlapping close-up tiles.
        <span class="vi-block-inline">· Chạy ở độ chi tiết tối đa: toàn khung hình cộng 4 ô phóng cận chồng mép.</span>
      </span>
    </div>

    <p id="status" class="text-[0.9rem] mb-3" style="color: var(--text-muted)"></p>

    <div class="rounded-lg overflow-hidden" style="background: var(--bg)">
      <canvas id="preview" class="block w-full h-auto"></canvas>
    </div>

    <div id="controls" class="hidden flex-wrap items-center gap-x-6 gap-y-3 mt-4">
      <label class="flex items-center gap-2 text-[0.9rem] cursor-pointer">
        <input id="showOriginal" type="checkbox" class="accent-[var(--accent)]" />
        <span>Check against original</span>
        <span class="vi-block-inline" style="color: var(--vi-text)">· Đối chiếu ảnh gốc</span>
      </label>
      <label id="opWrap" class="hidden items-center gap-2 text-[0.9rem]">
        <span>Opacity</span>
        <span class="vi-block-inline" style="color: var(--vi-text)">· Độ mờ</span>
        <input id="opacity" type="range" min="20" max="100" value="80" class="accent-[var(--accent)]" />
      </label>
    </div>

    <div id="legend" class="hidden mt-4">
      <p class="label !mb-2">Detected <span class="vi-block-inline" style="color: var(--vi-text)">· Nhận diện được</span></p>
      <div id="legendItems" class="flex flex-wrap gap-2"></div>
    </div>
  </section>

  <!-- ======================================= step 3 -->
  <section id="s3wrap" class="card p-6 mb-6 hidden" aria-labelledby="s3">
    <div class="flex items-baseline gap-2 mb-3 flex-wrap">
      <span class="chip chip-accent">3</span>
      <h2 id="s3" class="text-lg font-semibold">Save to your computer</h2>
      <span class="vi-block-inline text-[0.9rem]" style="color: var(--vi-text)">Lưu về máy</span>
    </div>
    <p class="text-[0.86rem] mb-1" style="color: var(--text-muted)">
      The download is the solid flat-colour label map at the original resolution — drop it into
      Photoshop and select by colour.
    </p>
    <p class="vi-block vi-def text-[0.85rem] mb-4">
      File tải về là bản đồ màu phẳng đặc ở đúng độ phân giải gốc — đưa vào Photoshop rồi chọn theo
      màu. Nên dùng PNG để giữ mép sắc nét.
    </p>
    <div class="flex flex-wrap gap-3">
      <button id="dlPng" class="btn btn-primary" type="button">Download PNG</button>
      <button id="dlJpg" class="btn" type="button">Download JPEG</button>
    </div>
  </section>

  <p class="text-[0.8rem] pb-6" style="color: var(--text-faint)">
    First use downloads the AI model once, then it is cached. Uses your GPU if the browser supports
    WebGPU. Back to <a href={url('/tools')} class="no-underline hover:underline">all tools</a>.
    <span class="vi-block-inline">
      Lần đầu dùng sẽ tải mô hình AI một lần rồi lưu cache. Dùng GPU nếu trình duyệt hỗ trợ WebGPU.
    </span>
  </p>
</Base>

<script>
  const TRANSFORMERS = 'https://cdn.jsdelivr.net/npm/@huggingface/transformers@3.8.1';
  const SEG = 'Xenova/segformer-b5-finetuned-ade-640-640';
  const DEPTH = 'onnx-community/depth-anything-v2-small';
  const WORK_MAX = 1100; // post-processing works at this longest side, then upscales

  const VI: Record<string, string> = {
    wall: 'tường', floor: 'sàn', flooring: 'sàn', ceiling: 'trần', windowpane: 'cửa sổ',
    window: 'cửa sổ', door: 'cửa', painting: 'tranh', picture: 'tranh', sofa: 'ghế sofa',
    couch: 'ghế sofa', chair: 'ghế', armchair: 'ghế bành', seat: 'chỗ ngồi', stool: 'ghế đẩu',
    bench: 'ghế băng', ottoman: 'đôn', pouf: 'đôn', table: 'bàn', 'coffee table': 'bàn trà',
    desk: 'bàn làm việc', lamp: 'đèn', light: 'đèn', chandelier: 'đèn chùm', curtain: 'rèm',
    blind: 'rèm sáo', rug: 'thảm', carpet: 'thảm', cushion: 'gối tựa', pillow: 'gối',
    bed: 'giường', cabinet: 'tủ', wardrobe: 'tủ quần áo', 'chest of drawers': 'tủ ngăn kéo',
    sideboard: 'tủ thấp', shelf: 'kệ', bookcase: 'kệ sách', book: 'sách', vase: 'bình',
    bottle: 'chai lọ', plant: 'cây', flower: 'hoa', tree: 'cây', mirror: 'gương',
    television: 'tivi', screen: 'màn hình', fireplace: 'lò sưởi', stairs: 'cầu thang',
    column: 'cột', railing: 'lan can', box: 'hộp', basket: 'giỏ', clock: 'đồng hồ',
    pot: 'chậu', tray: 'khay', countertop: 'mặt bàn bếp', sink: 'bồn rửa', person: 'người',
  };

  const WALL_LIKE = new Set(['wall']);
  const FLOOR_CEIL = new Set(['floor', 'flooring', 'ceiling']);
  const isArch = (n?: string) => !!n && (WALL_LIKE.has(first(n)) || FLOOR_CEIL.has(first(n)));
  const first = (label: string) => label.toLowerCase().split(';')[0].trim();

  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T | null;
  const fileInput = $<HTMLInputElement>('file');
  const drop = $('drop');
  const runBtn = $<HTMLButtonElement>('run');
  const statusEl = $('status');
  const preview = $<HTMLCanvasElement>('preview');

  let sourceImage: HTMLImageElement | null = null;
  let labelCanvas: HTMLCanvasElement | null = null; // solid label map, full res
  let segmenter: any = null, depther: any = null;

  const setStatus = (m: string, tone = 'var(--text-muted)') => {
    if (statusEl) { statusEl.textContent = m; statusEl.style.color = tone; }
  };

  // ------------------------------------------------------------- upload
  let originalImage: HTMLImageElement | null = null; // pristine upload, for Reset
  let cleanMask: Uint8Array | null = null; // 1 = brushed for removal

  function handleFile(file: File) {
    if (!file || !file.type.startsWith('image/')) return;
    const img = new Image();
    img.onload = () => {
      originalImage = img;
      sourceImage = img;
      cleanMask = new Uint8Array(img.naturalWidth * img.naturalHeight);
      labelCanvas = null;
      $('cleanWrap')?.classList.remove('hidden');
      $('dlClean')?.classList.add('hidden');
      $('s2wrap')?.classList.remove('hidden');
      $('s3wrap')?.classList.add('hidden');
      $('controls')?.classList.add('hidden');
      $('legend')?.classList.add('hidden');
      drawClean();
      drawPreview();
      setStatus('Ready — press Segment. · Sẵn sàng — bấm Segment.');
      $('cleanWrap')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    };
    img.src = URL.createObjectURL(file);
  }

  // ---------------------------------------------- clean text/logo (step 1b)
  const cleanCanvas = $<HTMLCanvasElement>('cleanCanvas');

  function drawClean() {
    if (!cleanCanvas || !sourceImage) return;
    const W = sourceImage.naturalWidth, H = sourceImage.naturalHeight;
    cleanCanvas.width = W; cleanCanvas.height = H;
    const ctx = cleanCanvas.getContext('2d')!;
    ctx.drawImage(sourceImage, 0, 0);
    if (!cleanMask) return;
    // show the brushed area as a red tint
    const id = ctx.getImageData(0, 0, W, H);
    for (let i = 0; i < W * H; i++) if (cleanMask[i]) {
      id.data[i * 4] = Math.min(255, id.data[i * 4] * 0.4 + 200);
      id.data[i * 4 + 1] *= 0.35; id.data[i * 4 + 2] *= 0.35;
    }
    ctx.putImageData(id, 0, 0);
  }

  let painting = false;
  function stamp(ev: PointerEvent) {
    if (!cleanCanvas || !cleanMask || !sourceImage) return;
    const rect = cleanCanvas.getBoundingClientRect();
    const W = sourceImage.naturalWidth, H = sourceImage.naturalHeight;
    const x = ((ev.clientX - rect.left) / rect.width) * W;
    const y = ((ev.clientY - rect.top) / rect.height) * H;
    const r = Number(($<HTMLInputElement>('brushSize'))?.value ?? 24) * (W / rect.width) * 0.5;
    const r2 = r * r;
    const x0 = Math.max(0, Math.floor(x - r)), x1 = Math.min(W - 1, Math.ceil(x + r));
    const y0 = Math.max(0, Math.floor(y - r)), y1 = Math.min(H - 1, Math.ceil(y + r));
    for (let yy = y0; yy <= y1; yy++) for (let xx = x0; xx <= x1; xx++) {
      const dx = xx - x, dy = yy - y;
      if (dx * dx + dy * dy <= r2) cleanMask[yy * W + xx] = 1;
    }
    drawClean();
  }
  cleanCanvas?.addEventListener('pointerdown', (e) => { painting = true; cleanCanvas.setPointerCapture(e.pointerId); stamp(e); });
  cleanCanvas?.addEventListener('pointermove', (e) => { if (painting) stamp(e); });
  cleanCanvas?.addEventListener('pointerup', () => { painting = false; });

  /**
   * Diffusion inpaint: solve the hole at quarter resolution (Jacobi iterations
   * over masked pixels), paste back bilinearly, then a few full-res passes to
   * blend the seam. Harmonic fill — smooth and natural on flat surfaces, which
   * is where watermarks live.
   */
  function inpaint(img: HTMLImageElement, mask: Uint8Array): HTMLCanvasElement {
    const W = img.naturalWidth, H = img.naturalHeight;
    const full = document.createElement('canvas');
    full.width = W; full.height = H;
    const fctx = full.getContext('2d')!;
    fctx.drawImage(img, 0, 0);
    const fid = fctx.getImageData(0, 0, W, H);

    // quarter-res working copy
    const s = 4, w = Math.max(2, Math.ceil(W / s)), h = Math.max(2, Math.ceil(H / s));
    const rgb = new Float32Array(w * h * 3);
    const hole = new Uint8Array(w * h);
    const cntArr = new Int32Array(w * h);
    for (let Y = 0; Y < H; Y++) for (let X = 0; X < W; X++) {
      const q = ((Y / s) | 0) * w + ((X / s) | 0), p = (Y * W + X) * 4;
      if (mask[Y * W + X]) { hole[q] = 1; continue; } // masked px must NOT seed the average
      rgb[q * 3] += fid.data[p]; rgb[q * 3 + 1] += fid.data[p + 1]; rgb[q * 3 + 2] += fid.data[p + 2];
      cntArr[q]++;
    }
    for (let q = 0; q < w * h; q++) { const n = cntArr[q]; if (n) { rgb[q * 3] /= n; rgb[q * 3 + 1] /= n; rgb[q * 3 + 2] /= n; } }
    // cells with no clean pixels: flood-fill initial values from known neighbours
    let pending = true;
    while (pending) {
      pending = false;
      for (let y = 0; y < h; y++) for (let x = 0; x < w; x++) {
        const q = y * w + x; if (cntArr[q]) continue;
        let r = 0, g = 0, b = 0, n = 0;
        const add = (j: number) => { if (cntArr[j]) { r += rgb[j * 3]; g += rgb[j * 3 + 1]; b += rgb[j * 3 + 2]; n++; } };
        if (x > 0) add(q - 1); if (x < w - 1) add(q + 1); if (y > 0) add(q - w); if (y < h - 1) add(q + w);
        if (n) { rgb[q * 3] = r / n; rgb[q * 3 + 1] = g / n; rgb[q * 3 + 2] = b / n; cntArr[q] = -1; }
        else pending = true;
      }
      // -1 markers become known for the next sweep
      for (let q = 0; q < w * h; q++) if (cntArr[q] === -1) cntArr[q] = 1;
    }

    // Jacobi diffusion on hole pixels
    for (let it = 0; it < 300; it++) {
      for (let y = 0; y < h; y++) for (let x = 0; x < w; x++) {
        const q = y * w + x; if (!hole[q]) continue;
        let r = 0, g = 0, b = 0, n = 0;
        const add = (j: number) => { r += rgb[j * 3]; g += rgb[j * 3 + 1]; b += rgb[j * 3 + 2]; n++; };
        if (x > 0) add(q - 1); if (x < w - 1) add(q + 1);
        if (y > 0) add(q - w); if (y < h - 1) add(q + w);
        if (n) { rgb[q * 3] = r / n; rgb[q * 3 + 1] = g / n; rgb[q * 3 + 2] = b / n; }
      }
    }

    // paste back into hole pixels, bilinear from the quarter grid
    for (let Y = 0; Y < H; Y++) for (let X = 0; X < W; X++) {
      if (!mask[Y * W + X]) continue;
      const fx = Math.min(w - 1.001, X / s), fy = Math.min(h - 1.001, Y / s);
      const x0 = fx | 0, y0 = fy | 0, tx = fx - x0, ty = fy - y0;
      const p = (Y * W + X) * 4;
      for (let ch = 0; ch < 3; ch++) {
        const a = rgb[(y0 * w + x0) * 3 + ch], b2 = rgb[(y0 * w + x0 + 1) * 3 + ch];
        const c2 = rgb[((y0 + 1) * w + x0) * 3 + ch], d2 = rgb[((y0 + 1) * w + x0 + 1) * 3 + ch];
        fid.data[p + ch] = a * (1 - tx) * (1 - ty) + b2 * tx * (1 - ty) + c2 * (1 - tx) * ty + d2 * tx * ty;
      }
    }
    // blend seams: a few full-res passes over masked px
    const D = fid.data;
    for (let it = 0; it < 6; it++) {
      for (let Y = 1; Y < H - 1; Y++) for (let X = 1; X < W - 1; X++) {
        const i = Y * W + X; if (!mask[i]) continue;
        const p = i * 4;
        for (let ch = 0; ch < 3; ch++)
          D[p + ch] = (D[p - 4 + ch] + D[p + 4 + ch] + D[p - W * 4 + ch] + D[p + W * 4 + ch]) / 4;
      }
    }
    fctx.putImageData(fid, 0, 0);
    return full;
  }

  $('applyClean')?.addEventListener('click', () => {
    if (!originalImage || !cleanMask) return;
    let any = false; for (let i = 0; i < cleanMask.length; i++) if (cleanMask[i]) { any = true; break; }
    if (!any) return;
    setStatus('Filling… · Đang lấp vùng đã quét…');
    setTimeout(() => {
      const cleaned = inpaint(sourceImage!, cleanMask!);
      const img = new Image();
      img.onload = () => {
        sourceImage = img;
        cleanMask = new Uint8Array(img.naturalWidth * img.naturalHeight);
        labelCanvas = null;
        $('dlClean')?.classList.remove('hidden');
        drawClean(); drawPreview();
        setStatus('Cleaned. Brush more, or press Segment. · Đã lấp xong — quét tiếp hoặc bấm Segment.', 'var(--success)');
      };
      img.src = cleaned.toDataURL('image/png');
    }, 30);
  });

  $('resetClean')?.addEventListener('click', () => {
    if (!originalImage) return;
    sourceImage = originalImage;
    cleanMask = new Uint8Array(originalImage.naturalWidth * originalImage.naturalHeight);
    labelCanvas = null;
    $('dlClean')?.classList.add('hidden');
    drawClean(); drawPreview();
  });

  $('dlClean')?.addEventListener('click', () => {
    if (!sourceImage) return;
    const c = canvasOfImage(sourceImage);
    c.toBlob((b) => {
      if (!b) return;
      const a = document.createElement('a');
      a.href = URL.createObjectURL(b); a.download = 'cleaned.png'; a.click();
      URL.revokeObjectURL(a.href);
    }, 'image/png');
  });
  fileInput?.addEventListener('change', () => { if (fileInput.files?.[0]) handleFile(fileInput.files[0]); });
  ['dragover', 'dragenter'].forEach((ev) => drop?.addEventListener(ev, (e) => { e.preventDefault(); (drop as HTMLElement).style.borderColor = 'var(--accent)'; }));
  ['dragleave', 'drop'].forEach((ev) => drop?.addEventListener(ev, (e) => { e.preventDefault(); (drop as HTMLElement).style.borderColor = 'var(--border-strong)'; }));
  drop?.addEventListener('drop', (e) => { const f = (e as DragEvent).dataTransfer?.files?.[0]; if (f) handleFile(f); });

  // ------------------------------------------------------------- preview
  function drawPreview() {
    if (!preview || !sourceImage) return;
    const W = sourceImage.naturalWidth, H = sourceImage.naturalHeight;
    preview.width = W; preview.height = H;
    const ctx = preview.getContext('2d')!;
    ctx.clearRect(0, 0, W, H);
    const showOrig = ($<HTMLInputElement>('showOriginal'))?.checked;
    const alpha = (Number(($<HTMLInputElement>('opacity'))?.value ?? 80)) / 100;

    if (!labelCanvas) { ctx.drawImage(sourceImage, 0, 0); return; }
    if (showOrig) {
      ctx.drawImage(sourceImage, 0, 0);
      ctx.globalAlpha = alpha;
      ctx.drawImage(labelCanvas, 0, 0);
      ctx.globalAlpha = 1;
    } else {
      ctx.drawImage(labelCanvas, 0, 0); // solid labels by default
    }
  }
  $('showOriginal')?.addEventListener('change', () => {
    $('opWrap')?.classList.toggle('hidden', !($<HTMLInputElement>('showOriginal'))?.checked);
    $('opWrap')?.classList.toggle('flex', !!($<HTMLInputElement>('showOriginal'))?.checked);
    drawPreview();
  });
  $('opacity')?.addEventListener('input', drawPreview);

  // ------------------------------------------------------------- models
  async function getSegmenter(onProgress: any) {
    if (segmenter) return segmenter;
    const { pipeline } = await import(/* @vite-ignore */ TRANSFORMERS);
    const device = (navigator as any).gpu ? 'webgpu' : 'wasm';
    try { segmenter = await pipeline('image-segmentation', SEG, { device, progress_callback: onProgress }); }
    catch { segmenter = await pipeline('image-segmentation', SEG, { device: 'wasm', progress_callback: onProgress }); }
    return segmenter;
  }
  async function getDepther(onProgress: any) {
    if (depther) return depther;
    const { pipeline } = await import(/* @vite-ignore */ TRANSFORMERS);
    const device = (navigator as any).gpu ? 'webgpu' : 'wasm';
    try { depther = await pipeline('depth-estimation', DEPTH, { device, progress_callback: onProgress }); }
    catch { depther = await pipeline('depth-estimation', DEPTH, { device: 'wasm', progress_callback: onProgress }); }
    return depther;
  }

  // ------------------------------------------------------------- run
  runBtn?.addEventListener('click', async () => {
    if (!sourceImage) return;
    runBtn.disabled = true;
    const t0 = performance.now();
    const wantPlanes = ($<HTMLInputElement>('splitPlanes'))?.checked ?? true;

    const onProgress = (p: any) => {
      if (p?.status === 'progress' && p.total) {
        const pct = Math.round((p.loaded / p.total) * 100);
        setStatus(`Downloading model… ${pct}% · Đang tải mô hình… ${pct}%`);
      }
    };

    try {
      setStatus('Loading models… · Đang tải mô hình…');
      const seg = await getSegmenter(onProgress);
      const dep = wantPlanes ? await getDepther(onProgress) : null;

      // work-grid dimensions (shared by inference merge and post-processing)
      const origW = sourceImage.naturalWidth, origH = sourceImage.naturalHeight;
      const scale = Math.min(1, WORK_MAX / Math.max(origW, origH));
      const W = Math.max(16, Math.round(origW * scale));
      const H = Math.max(16, Math.round(origH * scale));

      /**
       * Tiled inference. The model only ever sees ~640px, so a small or
       * distant object is a handful of pixels to it. One pass over the whole
       * frame anchors the big surfaces; four overlapping tiles each give the
       * model a close-up where small objects are ~2x larger. Masks merge by
       * label with a per-pixel max.
       */
      const src = canvasOfImage(sourceImage);
      const tiles: Array<{ sx: number; sy: number; sw: number; sh: number }> = [
        { sx: 0, sy: 0, sw: origW, sh: origH },
      ];
      const tw = Math.ceil(origW * 0.6), th = Math.ceil(origH * 0.6);
      for (const [tx, ty] of [[0, 0], [origW - tw, 0], [0, origH - th], [origW - tw, origH - th]] as const)
        tiles.push({ sx: tx, sy: ty, sw: tw, sh: th });

      const grids = new Map<string, Uint8Array>();
      let depOut: any = null;
      for (let i = 0; i < tiles.length; i++) {
        const t = tiles[i];
        setStatus(`Analysing ${i + 1}/${tiles.length}… · Đang phân tích ${i + 1}/${tiles.length}…`);
        const tc = document.createElement('canvas');
        tc.width = t.sw; tc.height = t.sh;
        tc.getContext('2d')!.drawImage(src, t.sx, t.sy, t.sw, t.sh, 0, 0, t.sw, t.sh);
        const url = tc.toDataURL('image/png');

        const jobs: Promise<any>[] = [seg(url)];
        if (i === 0 && dep) jobs.push(dep(url)); // depth only needs the full frame
        const [segOut, maybeDep] = await Promise.all(jobs);
        if (maybeDep) depOut = maybeDep;
        if (!Array.isArray(segOut)) continue;

        // tile rect in work-grid coordinates
        const gx = Math.round((t.sx / origW) * W), gy = Math.round((t.sy / origH) * H);
        const gw = Math.max(1, Math.round((t.sw / origW) * W)), gh = Math.max(1, Math.round((t.sh / origH) * H));
        for (const s of segOut) {
          const m = channelToGrid(s.mask, gw, gh, false);
          let g = grids.get(s.label);
          if (!g) { g = new Uint8Array(W * H); grids.set(s.label, g); }
          for (let y = 0; y < gh; y++) {
            const ry = gy + y; if (ry >= H) break;
            for (let x = 0; x < gw; x++) {
              const rx = gx + x; if (rx >= W) break;
              const v = m[y * gw + x], q = ry * W + rx;
              if (v > g[q]) g[q] = v;
            }
          }
        }
      }

      if (!grids.size) {
        setStatus('No objects detected. · Không nhận diện được vật thể.', 'var(--warning)');
        runBtn.disabled = false; return;
      }

      const segGrids = [...grids.entries()].map(([label, grid]) => ({ label, grid }));
      buildLabelMap(segGrids, depOut, wantPlanes, W, H);
      drawPreview();
      $('controls')?.classList.remove('hidden');
      $('legend')?.classList.remove('hidden');
      $('s3wrap')?.classList.remove('hidden');
      const secs = ((performance.now() - t0) / 1000).toFixed(1);
      setStatus(`Done in ${secs}s. · Xong sau ${secs}s.`, 'var(--success)');
    } catch (err: any) {
      console.error(err);
      setStatus('Could not run the model — needs a modern browser and internet on first use. · Không chạy được mô hình.', 'var(--danger)');
    } finally {
      runBtn.disabled = false;
    }
  });

  // ------------------------------------------------------------- helpers
  function canvasOfImage(img: HTMLImageElement) {
    const c = document.createElement('canvas');
    c.width = img.naturalWidth; c.height = img.naturalHeight;
    c.getContext('2d')!.drawImage(img, 0, 0);
    return c;
  }

  // Resize a single-channel RawImage to the work grid; returns Uint8 length W*H.
  function channelToGrid(raw: any, W: number, H: number, smooth: boolean): Uint8Array {
    const nat = document.createElement('canvas');
    nat.width = raw.width; nat.height = raw.height;
    const nctx = nat.getContext('2d')!;
    const id = nctx.createImageData(raw.width, raw.height);
    const ch = raw.channels ?? 1;
    for (let i = 0; i < raw.width * raw.height; i++) {
      const v = raw.data[i * ch];
      id.data[i * 4] = v; id.data[i * 4 + 1] = v; id.data[i * 4 + 2] = v; id.data[i * 4 + 3] = 255;
    }
    nctx.putImageData(id, 0, 0);
    const g = document.createElement('canvas');
    g.width = W; g.height = H;
    const gctx = g.getContext('2d')!;
    gctx.imageSmoothingEnabled = smooth;
    gctx.drawImage(nat, 0, 0, W, H);
    const out = new Uint8Array(W * H);
    const d = gctx.getImageData(0, 0, W, H).data;
    for (let i = 0; i < W * H; i++) out[i] = d[i * 4];
    return out;
  }

  function boxBlur(a: Float32Array, W: number, H: number, r: number) {
    const tmp = new Float32Array(a.length);
    for (let y = 0; y < H; y++) for (let x = 0; x < W; x++) {
      let s = 0, n = 0;
      for (let k = -r; k <= r; k++) { const xx = x + k; if (xx >= 0 && xx < W) { s += a[y * W + xx]; n++; } }
      tmp[y * W + x] = s / n;
    }
    for (let x = 0; x < W; x++) for (let y = 0; y < H; y++) {
      let s = 0, n = 0;
      for (let k = -r; k <= r; k++) { const yy = y + k; if (yy >= 0 && yy < H) { s += tmp[yy * W + x]; n++; } }
      a[y * W + x] = s / n;
    }
  }

  function hsv(h: number, s: number, v: number): [number, number, number] {
    const c = v * s, x = c * (1 - Math.abs(((h / 60) % 2) - 1)), m = v - c;
    let r = 0, g = 0, b = 0;
    if (h < 60) [r, g, b] = [c, x, 0]; else if (h < 120) [r, g, b] = [x, c, 0];
    else if (h < 180) [r, g, b] = [0, c, x]; else if (h < 240) [r, g, b] = [0, x, c];
    else if (h < 300) [r, g, b] = [x, 0, c]; else [r, g, b] = [c, 0, x];
    return [Math.round((r + m) * 255), Math.round((g + m) * 255), Math.round((b + m) * 255)];
  }

  // Grab the source image as an RGB byte array at an arbitrary resolution.
  function srcRGB(W: number, H: number): Uint8Array {
    const c = document.createElement('canvas');
    c.width = W; c.height = H;
    const ctx = c.getContext('2d')!;
    ctx.imageSmoothingEnabled = true;
    ctx.drawImage(sourceImage!, 0, 0, W, H);
    const d = ctx.getImageData(0, 0, W, H).data;
    const out = new Uint8Array(W * H * 3);
    for (let i = 0, j = 0; i < W * H; i++, j += 3) { out[j] = d[i * 4]; out[j + 1] = d[i * 4 + 1]; out[j + 2] = d[i * 4 + 2]; }
    return out;
  }

  /**
   * Bilateral majority vote: replace each label with the dominant label among
   * neighbours that are similar in BOTH the render's colour and its depth.
   * A colour edge OR a depth edge counts as a boundary, so this snaps wavy
   * semantic boundaries onto the real geometry — and, crucially, still finds
   * the ceiling/wall or floor/wall corner even when the two surfaces are the
   * same beige colour, because the depth jumps there.
   */
  function bilateralRefine(labels: Int32Array, src: Uint8Array, depth: Float32Array | null, W: number, H: number, iters: number, R: number, Sc: number, Sd: number) {
    const N = W * H;
    let cur = labels;
    let maxL = 0; for (let i = 0; i < N; i++) if (cur[i] > maxL) maxL = cur[i];
    const votes = new Float32Array(maxL + 2);
    const touched = new Int32Array((2 * R + 1) * (2 * R + 1));
    for (let it = 0; it < iters; it++) {
      const next = new Int32Array(N);
      for (let y = 0; y < H; y++) for (let x = 0; x < W; x++) {
        const p = y * W + x, pj = p * 3;
        const pr = src[pj], pg = src[pj + 1], pb = src[pj + 2], pd = depth ? depth[p] : 0;
        let nt = 0, best = cur[p], bestv = -1;
        for (let dy = -R; dy <= R; dy++) {
          const yy = y + dy; if (yy < 0 || yy >= H) continue;
          for (let dx = -R; dx <= R; dx++) {
            const xx = x + dx; if (xx < 0 || xx >= W) continue;
            const q = yy * W + xx, l = cur[q]; if (l < 0) continue;
            const qj = q * 3, dr = pr - src[qj], dg = pg - src[qj + 1], db = pb - src[qj + 2];
            let w = 1 / (1 + (dr * dr + dg * dg + db * db) / Sc);
            if (depth) { const dd = pd - depth[q]; w *= 1 / (1 + (dd * dd) / Sd); }
            if (votes[l] === 0) touched[nt++] = l;
            votes[l] += w;
          }
        }
        for (let k = 0; k < nt; k++) { const l = touched[k]; if (votes[l] > bestv) { bestv = votes[l]; best = l; } votes[l] = 0; }
        next[p] = best;
      }
      cur = next;
    }
    return cur;
  }

  // N well-separated colours (golden-angle hue) for giving every region a
  // unique colour — so selecting by colour in Photoshop never picks up two
  // different surfaces (the ceiling and the floor were both red before this).
  function buildPalette(n: number): [number, number, number][] {
    const p: [number, number, number][] = [];
    for (let i = 0; i < n; i++) p.push(hsv((i * 137.508) % 360, 0.86 - (i % 3) * 0.12, 0.99 - (i % 2) * 0.16));
    return p;
  }

  // -------------------------------------- the core: build the label map
  function buildLabelMap(
    segGrids: Array<{ label: string; grid: Uint8Array }>,
    depOut: any,
    wantPlanes: boolean,
    W: number,
    H: number
  ) {
    const origW = sourceImage!.naturalWidth, origH = sourceImage!.naturalHeight;
    const N = W * H;
    const srcW = srcRGB(W, H);

    // 1. argmax class per pixel (full coverage, no holes)
    let classIdx = new Int32Array(N).fill(-1);
    const bestVal = new Uint8Array(N);
    const classNames: string[] = [];
    for (const seg of segGrids) {
      const k = classNames.length;
      classNames.push(seg.label);
      const m = seg.grid; // already merged at work resolution
      for (let i = 0; i < N; i++) if (m[i] > bestVal[i]) { bestVal[i] = m[i]; classIdx[i] = k; }
    }

    // depth grid first — it also guides the boundary refinement
    let depthGrid: Float32Array | null = null;
    if (depOut) {
      const raw = depOut.depth ?? depOut.predicted_depth ?? depOut;
      depthGrid = Float32Array.from(channelToGrid(raw, W, H, true));
      boxBlur(depthGrid, W, H, 3);
    }

    // 1b. snap the coarse class boundaries onto the render's real edges —
    // colour edges AND depth edges, so same-coloured ceiling/wall corners hold
    classIdx = bilateralRefine(classIdx, srcW, depthGrid, W, H, 2, 3, 1400, 18) as typeof classIdx;

    // 1c. furniture standing flush against a wall (her lower cabinet under the
    // artwork) often gets classed as "wall". It sits NEARER the camera than
    // the wall plane behind it, so carve out wall pixels that are markedly
    // nearer than the robust wall depth of their column.
    const raisedK = classNames.length;
    classNames.push('object at wall');
    if (depthGrid) {
      const colMed = new Float32Array(W).fill(NaN);
      const tmpD: number[] = [];
      for (let x = 0; x < W; x++) {
        tmpD.length = 0;
        for (let y = 0; y < H; y++) {
          const p = y * W + x;
          const nm = classNames[classIdx[p]];
          if (nm && WALL_LIKE.has(first(nm))) tmpD.push(depthGrid[p]);
        }
        if (tmpD.length >= H * 0.08) { tmpD.sort((a, b) => a - b); colMed[x] = tmpD[tmpD.length >> 1]; }
      }
      // spread of residuals → robust threshold
      const res: number[] = [];
      for (let p = 0; p < N; p++) {
        const nm = classNames[classIdx[p]];
        if (!nm || !WALL_LIKE.has(first(nm))) continue;
        const m = colMed[p % W]; if (Number.isNaN(m)) continue;
        res.push(Math.abs(depthGrid[p] - m));
      }
      res.sort((a, b) => a - b);
      const mad = res.length ? res[res.length >> 1] : 3;
      const Tp = Math.max(mad * 4, 10); // depth units are 0..255 inverse depth
      for (let p = 0; p < N; p++) {
        const nm = classNames[classIdx[p]];
        if (!nm || !WALL_LIKE.has(first(nm))) continue;
        const m = colMed[p % W]; if (Number.isNaN(m)) continue;
        if (depthGrid[p] - m > Tp) classIdx[p] = raisedK; // nearer = brighter
      }
    }

    // 2. wall-plane split — WALLS ONLY, decided PER COLUMN, not per pixel.
    // Wall corners in an interior are near-vertical lines, so classifying
    // whole columns is far more robust than thresholding noisy per-pixel
    // gradients (which left all three walls one colour on a real render),
    // and it produces perfectly straight vertical plane boundaries.
    const bucket = new Uint8Array(N);
    if (wantPlanes && depthGrid) {
      const gx = new Float32Array(N);
      for (let y = 0; y < H; y++) for (let x = 0; x < W; x++) {
        const i = y * W + x;
        gx[i] = depthGrid[y * W + Math.min(x + 2, W - 1)] - depthGrid[y * W + Math.max(x - 2, 0)];
      }

      // robust per-column wall slope: median of gx over the wall pixels there
      const colSlope = new Float32Array(W).fill(NaN);
      const tmp: number[] = [];
      for (let x = 0; x < W; x++) {
        tmp.length = 0;
        for (let y = 0; y < H; y++) {
          const p = y * W + x;
          const nm = classNames[classIdx[p]];
          if (nm && WALL_LIKE.has(first(nm))) tmp.push(gx[p]);
        }
        if (tmp.length >= H * 0.05) {
          tmp.sort((a, b) => a - b);
          colSlope[x] = tmp[tmp.length >> 1];
        }
      }
      // fill gaps (columns with no wall) from the nearest valid neighbour
      let last = NaN;
      for (let x = 0; x < W; x++) { if (Number.isNaN(colSlope[x])) colSlope[x] = last; else last = colSlope[x]; }
      last = NaN;
      for (let x = W - 1; x >= 0; x--) { if (Number.isNaN(colSlope[x])) colSlope[x] = last; else last = colSlope[x]; }

      // smooth the 1D signal
      const sm = new Float32Array(W);
      const SR = Math.max(2, Math.round(W * 0.01));
      for (let x = 0; x < W; x++) {
        let s = 0, n = 0;
        for (let k = -SR; k <= SR; k++) { const xx = x + k; if (xx >= 0 && xx < W && !Number.isNaN(colSlope[xx])) { s += colSlope[xx]; n++; } }
        sm[x] = n ? s / n : 0;
      }

      // threshold from robust spread (median absolute deviation)
      const absDev = [...sm].map(Math.abs).sort((a, b) => a - b);
      const mad = absDev[absDev.length >> 1] || 0.1;
      const T = Math.max(mad * 1.2, 0.15);

      // classify columns, then clean up: median filter + minimum run length,
      // so the wall splits into a few solid vertical bands, not flicker
      const colClass = new Uint8Array(W);
      for (let x = 0; x < W; x++) colClass[x] = sm[x] < -T ? 0 : sm[x] > T ? 2 : 1;
      const MIN_RUN = Math.max(4, Math.round(W * 0.06));
      let runStart = 0;
      for (let x = 1; x <= W; x++) {
        if (x === W || colClass[x] !== colClass[runStart]) {
          if (x - runStart < MIN_RUN) {
            const fill = runStart > 0 ? colClass[runStart - 1] : (x < W ? colClass[x] : colClass[runStart]);
            for (let k = runStart; k < x; k++) colClass[k] = fill;
          }
          runStart = x;
        }
      }

      for (let p = 0; p < N; p++) {
        const nm = classNames[classIdx[p]];
        if (nm && WALL_LIKE.has(first(nm))) bucket[p] = colClass[p % W];
      }
    }

    // 3. connected components over (classIdx, bucket)
    const comp = new Int32Array(N).fill(-1);
    const compClass: number[] = [];
    const compBucket: number[] = [];
    const compSize: number[] = [];
    const stack = new Int32Array(N);
    let nComp = 0;
    for (let s = 0; s < N; s++) {
      if (comp[s] !== -1 || classIdx[s] < 0) continue;
      const ck = classIdx[s], bk = bucket[s], id = nComp++;
      compClass.push(ck); compBucket.push(bk); let size = 0, sp = 0;
      stack[sp++] = s; comp[s] = id;
      while (sp > 0) {
        const p = stack[--sp]; size++;
        const x = p % W, y = (p / W) | 0;
        if (x > 0) { const q = p - 1; if (comp[q] === -1 && classIdx[q] === ck && bucket[q] === bk) { comp[q] = id; stack[sp++] = q; } }
        if (x < W - 1) { const q = p + 1; if (comp[q] === -1 && classIdx[q] === ck && bucket[q] === bk) { comp[q] = id; stack[sp++] = q; } }
        if (y > 0) { const q = p - W; if (comp[q] === -1 && classIdx[q] === ck && bucket[q] === bk) { comp[q] = id; stack[sp++] = q; } }
        if (y < H - 1) { const q = p + W; if (comp[q] === -1 && classIdx[q] === ck && bucket[q] === bk) { comp[q] = id; stack[sp++] = q; } }
      }
      compSize.push(size);
    }

    // 4. merge speckle into the neighbour with the longest shared border.
    // 0.4% of the frame: aggressive enough that a clean render yields a
    // handful of solid regions, not confetti.
    const minSize = Math.max(48, Math.round(N * 0.004));
    const remap = new Int32Array(nComp);
    for (let i = 0; i < nComp; i++) remap[i] = i;
    const find = (a: number) => { while (remap[a] !== a) a = remap[a] = remap[remap[a]]; return a; };
    const edges = new Map<number, Map<number, number>>();
    const addEdge = (a: number, b: number) => { if (a === b) return; if (!edges.has(a)) edges.set(a, new Map()); const m = edges.get(a)!; m.set(b, (m.get(b) ?? 0) + 1); };
    for (let p = 0; p < N; p++) {
      const a = comp[p]; if (a < 0) continue;
      const x = p % W, y = (p / W) | 0;
      if (x < W - 1) { const b = comp[p + 1]; if (b >= 0 && b !== a) { addEdge(a, b); addEdge(b, a); } }
      if (y < H - 1) { const b = comp[p + W]; if (b >= 0 && b !== a) { addEdge(a, b); addEdge(b, a); } }
    }
    const order = [...Array(nComp).keys()].sort((a, b) => compSize[a] - compSize[b]);
    for (const cId of order) {
      if (compSize[find(cId)] >= minSize) continue;
      const nbrs = edges.get(cId); if (!nbrs || !nbrs.size) continue;
      let best = -1, bestLen = -1;
      for (const [nb, len] of nbrs) { const r = find(nb); if (r === find(cId)) continue; if (len > bestLen) { bestLen = len; best = r; } }
      if (best >= 0) { const rc = find(cId); compSize[best] += compSize[rc]; remap[rc] = best; }
    }

    // 4b. compact regions to a dense root index
    const rootIndex = new Map<number, number>();
    const rootClass: number[] = [];
    const rootBucket: number[] = [];
    const rootSize: number[] = [];
    for (let i = 0; i < nComp; i++) {
      if (find(i) !== i) continue;
      rootIndex.set(i, rootIndex.size);
      rootClass.push(compClass[i]); rootBucket.push(compBucket[i]); rootSize.push(compSize[i]);
    }
    const nReg = rootIndex.size;
    const regionOf = new Int32Array(N);
    for (let p = 0; p < N; p++) { const a = comp[p]; regionOf[p] = a >= 0 ? rootIndex.get(find(a))! : -1; }

    // 5. colour like a material pass: one colour per KIND of thing, the way
    // V-Ray does it — both armchairs share a colour, all pieces of floor share
    // a colour. Walls are the exception: each orientation plane gets its own,
    // because lighting them separately is the whole point.
    const keyOfRegion = (r: number): string => {
      const nm = first(classNames[rootClass[r]] ?? 'unknown');
      return WALL_LIKE.has(nm) ? `wall|${rootBucket[r]}` : nm;
    };
    const keyArea = new Map<string, number>();
    for (let r = 0; r < nReg; r++) keyOfRegion(r) && keyArea.set(keyOfRegion(r), (keyArea.get(keyOfRegion(r)) ?? 0) + rootSize[r]);
    const keysByArea = [...keyArea.entries()].sort((a, b) => b[1] - a[1]).map(([k]) => k);
    const palette = buildPalette(Math.max(keysByArea.length, 8));
    const keyColor = new Map<string, [number, number, number]>();
    keysByArea.forEach((k, rank) => keyColor.set(k, palette[rank % palette.length]));
    const regColor: [number, number, number][] = new Array(nReg);
    for (let r = 0; r < nReg; r++) regColor[r] = keyColor.get(keyOfRegion(r))!;

    // 6. upscale the region map to full resolution (nearest), then snap the
    //    boundaries to the full-res render edges so lines come out crisp.
    let fullReg = new Int32Array(origW * origH);
    for (let Y = 0; Y < origH; Y++) {
      const wy = Math.min(H - 1, (Y * H / origH) | 0);
      for (let X = 0; X < origW; X++) {
        const wx = Math.min(W - 1, (X * W / origW) | 0);
        fullReg[Y * origW + X] = regionOf[wy * W + wx];
      }
    }
    const srcF = srcRGB(origW, origH);
    fullReg = boundaryRefineRegions(fullReg, srcF, origW, origH, 2, 2, 1200) as typeof fullReg;

    // 7. paint the final solid label map
    labelCanvas = document.createElement('canvas');
    labelCanvas.width = origW; labelCanvas.height = origH;
    const lctx = labelCanvas.getContext('2d')!;
    const out = lctx.createImageData(origW, origH);
    for (let p = 0; p < origW * origH; p++) {
      const r = fullReg[p];
      const c = r >= 0 ? regColor[r] : [18, 18, 18];
      out.data[p * 4] = c[0]; out.data[p * 4 + 1] = c[1]; out.data[p * 4 + 2] = c[2]; out.data[p * 4 + 3] = 255;
    }
    lctx.putImageData(out, 0, 0);

    // 8. legend, one entry per colour key
    const perKey = new Map<string, { color: [number, number, number]; regions: number; area: number }>();
    for (let r = 0; r < nReg; r++) {
      const key = keyOfRegion(r);
      const e = perKey.get(key) ?? { color: regColor[r], regions: 0, area: 0 };
      e.regions++; e.area += rootSize[r];
      if (!perKey.has(key)) perKey.set(key, e);
    }
    renderLegend(perKey);
  }

  /** Same bilateral idea, at full resolution, on region ids, boundary pixels only. */
  function boundaryRefineRegions(reg: Int32Array, src: Uint8Array, W: number, H: number, iters: number, R: number, S: number) {
    const N = W * H;
    let maxR = 0; for (let i = 0; i < N; i++) if (reg[i] > maxR) maxR = reg[i];
    const votes = new Float32Array(maxR + 2);
    const touched = new Int32Array((2 * R + 1) * (2 * R + 1));
    let cur = reg;
    for (let it = 0; it < iters; it++) {
      const isB = new Uint8Array(N);
      for (let p = 0; p < N; p++) {
        const x = p % W, y = (p / W) | 0, r = cur[p];
        if ((x > 0 && cur[p - 1] !== r) || (x < W - 1 && cur[p + 1] !== r) || (y > 0 && cur[p - W] !== r) || (y < H - 1 && cur[p + W] !== r)) isB[p] = 1;
      }
      const next = Int32Array.from(cur);
      for (let p = 0; p < N; p++) {
        if (!isB[p]) continue;
        const x = p % W, y = (p / W) | 0, pj = p * 3;
        const pr = src[pj], pg = src[pj + 1], pb = src[pj + 2];
        let nt = 0, best = cur[p], bestv = -1;
        for (let dy = -R; dy <= R; dy++) {
          const yy = y + dy; if (yy < 0 || yy >= H) continue;
          for (let dx = -R; dx <= R; dx++) {
            const xx = x + dx; if (xx < 0 || xx >= W) continue;
            const q = yy * W + xx, r = cur[q]; if (r < 0) continue;
            const qj = q * 3, dr = pr - src[qj], dg = pg - src[qj + 1], db = pb - src[qj + 2];
            const w = 1 / (1 + (dr * dr + dg * dg + db * db) / S);
            if (votes[r] === 0) touched[nt++] = r;
            votes[r] += w;
          }
        }
        for (let k = 0; k < nt; k++) { const r = touched[k]; if (votes[r] > bestv) { bestv = votes[r]; best = r; } votes[r] = 0; }
        next[p] = best;
      }
      cur = next;
    }
    return cur;
  }

  const KEY_LABELS: Record<string, [string, string]> = {
    'wall|0': ['wall — left', 'tường trái'],
    'wall|1': ['wall — centre', 'tường giữa'],
    'wall|2': ['wall — right', 'tường phải'],
    'object at wall': ['object at wall', 'vật trước tường'],
  };

  function renderLegend(perKey: Map<string, { color: number[]; regions: number; area: number }>) {
    const box = $('legendItems'); if (!box) return;
    box.innerHTML = '';
    const items = [...perKey.entries()].sort((a, b) => b[1].area - a[1].area);
    for (const [key, info] of items) {
      const special = KEY_LABELS[key];
      const name = special ? special[0] : key;
      const vi = special ? special[1] : VI[key];
      const chip = document.createElement('span');
      chip.className = 'chip';
      chip.innerHTML =
        `<span style="display:inline-block;width:12px;height:12px;border-radius:3px;background:rgb(${info.color[0]},${info.color[1]},${info.color[2]})"></span>` +
        `${name}${info.regions > 1 ? ` <span style="opacity:.7">×${info.regions}</span>` : ''}` +
        `${vi ? ` · <span style="color:var(--vi-text)">${vi}</span>` : ''}`;
      box.appendChild(chip);
    }
  }

  // ------------------------------------------------------------- download
  function download(type: 'image/png' | 'image/jpeg') {
    if (!labelCanvas) return;
    const ext = type === 'image/png' ? 'png' : 'jpg';
    labelCanvas.toBlob((blob) => {
      if (!blob) return;
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = `labels.${ext}`;
      a.click();
      URL.revokeObjectURL(a.href);
    }, type, type === 'image/jpeg' ? 0.95 : undefined);
  }
  $('dlPng')?.addEventListener('click', () => download('image/png'));
  $('dlJpg')?.addEventListener('click', () => download('image/jpeg'));
</script>
