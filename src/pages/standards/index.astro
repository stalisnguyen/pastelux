---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import { url } from '../../site';

const groups = [
  {
    region: 'Vietnam',
    viRegion: 'Việt Nam',
    accent: true,
    items: [
      {
        code: 'TCVN 7114-1:2008',
        title: 'Ergonomics — Lighting of work places, Part 1: Indoor',
        note: 'The national adoption of ISO 8995-1 / CIE S 008. Illuminance, UGR and Ra requirements by space type. Structurally close to the 2002 edition of EN 12464-1, so values largely align with the European table — but the newer EN concepts (task-area modifiers, cylindrical illuminance) are not present.',
        status: 'current',
        viTitle: 'Ecgônômi — Chiếu sáng nơi làm việc, Phần 1: Trong nhà',
        viNote: 'Bản chấp nhận quốc gia của ISO 8995-1 / CIE S 008. Yêu cầu độ rọi, UGR và Ra theo loại không gian. Cấu trúc gần với EN 12464-1 bản 2002 nên các giá trị phần lớn khớp với bảng châu Âu — nhưng không có các khái niệm mới của EN (hệ số điều chỉnh theo vùng công việc, độ rọi trụ).',
      },
      {
        code: 'TCVN 7114-3:2008',
        title: 'Lighting of work places, Part 3: Outdoor work places',
        note: 'Exterior work areas. Pair it with local planning conditions for obtrusive light.',
        status: 'current',
        viTitle: 'Chiếu sáng nơi làm việc, Phần 3: Nơi làm việc ngoài nhà',
        viNote: 'Khu vực làm việc ngoài trời. Dùng kèm các điều kiện quy hoạch địa phương về ánh sáng gây phiền (obtrusive light).',
      },
      {
        code: 'QCVN 09:2017/BXD',
        title: 'National technical regulation on energy efficiency buildings',
        note: 'Mandatory regulation, not a voluntary standard. Sets lighting power density caps by space type alongside envelope and HVAC requirements. Applies to buildings above the floor-area threshold stated in the regulation — check the current threshold and any amendment before relying on it.',
        status: 'mandatory',
        viTitle: 'Quy chuẩn kỹ thuật quốc gia về các công trình xây dựng sử dụng năng lượng hiệu quả',
        viNote: 'Quy chuẩn bắt buộc, không phải tiêu chuẩn tự nguyện. Đặt giới hạn mật độ công suất chiếu sáng (LPD) theo loại không gian, bên cạnh yêu cầu về vỏ bao che và HVAC. Áp dụng cho công trình vượt ngưỡng diện tích sàn ghi trong quy chuẩn — kiểm tra ngưỡng hiện hành và các sửa đổi trước khi dựa vào.',
      },
      {
        code: 'TCXDVN 333:2005',
        title: 'Exterior lighting of public works and technical infrastructure',
        note: 'Exterior and urban lighting design. Older document; confirm current status with the local authority for the project.',
        status: 'check',
        viTitle: 'Chiếu sáng nhân tạo bên ngoài các công trình công cộng và kỹ thuật hạ tầng đô thị',
        viNote: 'Thiết kế chiếu sáng ngoài nhà và đô thị. Tài liệu đã cũ; xác nhận hiệu lực hiện tại với cơ quan quản lý địa phương của dự án.',
      },
      {
        code: 'QCVN 06:2022/BXD',
        title: 'Fire safety for buildings',
        note: 'Contains the emergency and escape lighting obligations that sit alongside the lighting design.',
        status: 'mandatory',
        viTitle: 'Quy chuẩn kỹ thuật quốc gia về an toàn cháy cho nhà và công trình',
        viNote: 'Chứa các yêu cầu về chiếu sáng sự cố và chiếu sáng thoát nạn, đi song song với thiết kế chiếu sáng.',
      },
    ],
  },
  {
    region: 'Europe',
    viRegion: 'Châu Âu',
    items: [
      {
        code: 'EN 12464-1:2021',
        title: 'Light and lighting — Lighting of work places, Part 1: Indoor',
        note: 'The reference document for indoor workplace lighting. The 2021 revision was substantial: task-area context modifiers, explicit cylindrical illuminance, wall and ceiling illuminance requirements, and revised treatment of daylight provision. Do not design to the 2011 table by habit.',
        status: 'current',
        viTitle: 'Ánh sáng và chiếu sáng — Chiếu sáng nơi làm việc, Phần 1: Trong nhà',
        viNote: 'Tài liệu tham chiếu cho chiếu sáng nơi làm việc trong nhà. Bản sửa 2021 thay đổi nhiều: hệ số điều chỉnh theo bối cảnh vùng công việc, độ rọi trụ được nêu rõ, yêu cầu độ rọi tường và trần, và cách xử lý mới cho ánh sáng tự nhiên. Đừng thiết kế theo bảng 2011 chỉ vì quen tay.',
      },
      {
        code: 'EN 12464-2:2014',
        title: 'Lighting of work places, Part 2: Outdoor work places',
        note: 'Exterior work areas, including obtrusive light limits by environmental zone.',
        status: 'current',
        viTitle: 'Chiếu sáng nơi làm việc, Phần 2: Nơi làm việc ngoài nhà',
        viNote: 'Khu vực làm việc ngoài trời, gồm giới hạn ánh sáng gây phiền theo vùng môi trường.',
      },
      {
        code: 'EN 1838:2013',
        title: 'Emergency lighting',
        note: 'Escape route, open area and high-risk task area lighting. Frequently the constraint that reshapes a ceiling layout.',
        status: 'current',
        viTitle: 'Chiếu sáng sự cố',
        viNote: 'Chiếu sáng lối thoát nạn, khu vực mở và khu vực công việc rủi ro cao. Thường là ràng buộc buộc phải vẽ lại bố trí trần.',
      },
      {
        code: 'EN 12193',
        title: 'Sports lighting',
        note: 'Class I–III by level of competition, with vertical illuminance and uniformity for broadcast.',
        status: 'current',
        viTitle: 'Chiếu sáng thể thao',
        viNote: 'Cấp I–III theo mức độ thi đấu, kèm độ rọi đứng và độ đồng đều cho truyền hình.',
      },
      {
        code: 'EU 2019/2020',
        title: 'Ecodesign requirements for light sources',
        note: 'Sets the flicker limits now routinely specified — PstLM ≤ 1.0 and SVM ≤ 0.4 — plus efficacy floors.',
        status: 'mandatory',
        viTitle: 'Yêu cầu thiết kế sinh thái (Ecodesign) cho nguồn sáng',
        viNote: 'Đặt ra giới hạn flicker nay thường được ghi trong spec — PstLM ≤ 1.0 và SVM ≤ 0.4 — cùng mức hiệu suất phát quang tối thiểu.',
      },
    ],
  },
  {
    region: 'International & North America',
    viRegion: 'Quốc tế & Bắc Mỹ',
    items: [
      {
        code: 'CIE S 026:2018',
        title: 'System for metrology of optical radiation for ipRGC-influenced responses to light',
        note: 'Defines the five α-opic quantities and melanopic EDI. The measurement basis for essentially all current circadian design guidance, including WELL. A metrology standard — it tells you how to quantify, not what to target.',
        status: 'current',
        viTitle: 'Hệ đo lường bức xạ quang cho các đáp ứng với ánh sáng chịu ảnh hưởng của ipRGC',
        viNote: 'Định nghĩa năm đại lượng α-opic và melanopic EDI. Là cơ sở đo lường cho gần như mọi hướng dẫn thiết kế nhịp sinh học (circadian) hiện nay, kể cả WELL. Đây là tiêu chuẩn đo lường — cho biết cách định lượng, không cho biết mục tiêu.',
      },
      {
        code: 'CIE 150:2017',
        title: 'Limiting the effects of obtrusive light from outdoor installations',
        note: 'The environmental-zone framework (E0–E4) and the limits for upward light, trespass, source intensity and façade luminance.',
        status: 'current',
        viTitle: 'Hạn chế tác động của ánh sáng gây phiền từ hệ chiếu sáng ngoài trời',
        viNote: 'Khung vùng môi trường (E0–E4) và các giới hạn cho ánh sáng hắt lên trời, ánh sáng tràn, cường độ nguồn và độ chói mặt dựng.',
      },
      {
        code: 'IES LP-6-25',
        title: 'Lighting Practice: lighting control systems',
        note: 'The 2025 revision added spectral tunability, circadian effects, cybersecurity for controls, and non-energy benefits — a good marker of where the discipline has moved.',
        status: 'current',
        viTitle: 'Thực hành chiếu sáng: hệ thống điều khiển chiếu sáng',
        viNote: 'Bản sửa 2025 bổ sung khả năng điều chỉnh phổ, tác động nhịp sinh học, an ninh mạng cho hệ điều khiển và các lợi ích ngoài năng lượng — một dấu mốc cho thấy nghề đã đi tới đâu.',
      },
      {
        code: 'IES TM-30-24',
        title: 'Method for evaluating light source colour rendition',
        note: 'Rf (fidelity) and Rg (gamut) over 99 real-world samples, plus the colour vector graphic.',
        status: 'current',
        viTitle: 'Phương pháp đánh giá độ hoàn màu của nguồn sáng',
        viNote: 'Rf (độ trung thực) và Rg (gam màu) trên 99 mẫu màu thực tế, cùng biểu đồ vector màu.',
      },
      {
        code: 'IES LM-80 / TM-21',
        title: 'LED lumen maintenance measurement and projection',
        note: 'LM-80 measures, TM-21 projects. An L70 claim without the drive current and case temperature it was derived at is not a specification.',
        status: 'current',
        viTitle: 'Đo và dự báo duy trì quang thông của LED',
        viNote: 'LM-80 để đo, TM-21 để dự báo. Một con số L70 mà không kèm dòng điện vận hành và nhiệt độ vỏ đã dùng để tính ra nó thì chưa phải là thông số kỹ thuật.',
      },
      {
        code: 'ANSI/IES LP-1, LP-2, LP-3',
        title: 'Lighting practice: designing quality lighting for people',
        note: 'The IES design-process documents. Useful counterweight to purely numerical compliance.',
        status: 'current',
        viTitle: 'Thực hành chiếu sáng: thiết kế ánh sáng chất lượng cho con người',
        viNote: 'Bộ tài liệu về quy trình thiết kế của IES. Đối trọng hữu ích cho việc chỉ chạy theo con số tuân thủ.',
      },
      {
        code: 'WELL v2 — L01…L09',
        title: 'WELL Building Standard, Light concept',
        note: 'L03 Circadian Lighting Design is the melanopic EDI credit. Others cover glare control, visual balance, electric light quality and occupant control.',
        status: 'current',
        viTitle: 'Tiêu chuẩn công trình WELL, nhóm Ánh sáng (Light)',
        viNote: 'L03 Circadian Lighting Design là tín chỉ về melanopic EDI. Các mục khác gồm kiểm soát chói, cân bằng thị giác, chất lượng ánh sáng điện và quyền điều khiển của người sử dụng.',
      },
      {
        code: 'ASHRAE 90.1',
        title: 'Energy standard for buildings',
        note: 'The LPD reference used by LEED and by many national codes as a baseline.',
        status: 'current',
        viTitle: 'Tiêu chuẩn năng lượng cho công trình',
        viNote: 'Tham chiếu LPD mà LEED và nhiều quy chuẩn quốc gia dùng làm mức cơ sở.',
      },
    ],
  },
];

const statusStyle: Record<string, string> = {
  mandatory: 'color: var(--danger); border-color: color-mix(in srgb, var(--danger) 35%, transparent)',
  check: 'color: var(--warning); border-color: color-mix(in srgb, var(--warning) 35%, transparent)',
  current: '',
};
const statusLabel: Record<string, string> = {
  mandatory: 'mandatory',
  check: 'verify status',
  current: '',
};
const viStatusLabel: Record<string, string> = {
  mandatory: 'bắt buộc',
  check: 'cần kiểm tra hiệu lực',
  current: '',
};
---

<Base
  title="Standards"
  description="The Vietnamese, European and international standards that govern architectural lighting design, and what each one is actually for."
>
  <PageHeader
    eyebrow="Reference"
    title="Standards"
    viTitle="Tiêu chuẩn"
    lede="What applies, what changed recently, and which document answers which question."
  >
    <p class="vi-block vi-def mt-2 text-[0.95rem] max-w-2xl leading-relaxed">
      Tiêu chuẩn nào áp dụng, gần đây có gì thay đổi, và tra câu hỏi nào thì mở tài liệu nào.
      Nhóm Việt Nam ở đầu trang; phần châu Âu và quốc tế ở dưới.
    </p>
    <div class="mt-6 flex flex-wrap gap-3">
      <a href={url('/standards/compare')} class="btn btn-primary">Illuminance criteria table →<span class="vi-block-inline font-normal" style="opacity: 0.8"> · Bảng tiêu chí độ rọi</span></a>
    </div>
  </PageHeader>

  <div
    class="card p-4 mb-9 text-[0.9rem] leading-relaxed"
    style="border-color: color-mix(in srgb, var(--warning) 40%, transparent)"
  >
    <strong style="color: var(--warning)">Read this first.</strong>
    <span style="color: var(--text-muted)">
      These pages summarise scope and intent. They are not a substitute for the standards
      themselves, which are copyrighted and must be purchased. Always design and certify against
      the current purchased edition, and confirm which version the project's contract calls up —
      it is often not the newest one.
    </span>
    <span class="vi-block vi-def mt-2 text-[0.86rem]">
      <strong>Đọc trước.</strong> Các trang này tóm tắt phạm vi và mục đích của từng tiêu chuẩn,
      không thay thế được bản tiêu chuẩn gốc — vốn có bản quyền và phải mua. Luôn thiết kế và nghiệm
      thu theo bản hiện hành đã mua, và xác nhận hợp đồng dự án yêu cầu phiên bản nào — thường không
      phải bản mới nhất.
    </span>
  </div>

  <div class="grid gap-10 pb-6">
    {
      groups.map((g) => (
        <section aria-labelledby={`grp-${g.region}`}>
          <div class="flex items-center gap-3 mb-4">
            <h2
              id={`grp-${g.region}`}
              class="text-lg font-semibold"
              style={g.accent ? 'color: var(--accent)' : ''}
            >
              {g.region}
            </h2>
            {g.viRegion && g.viRegion !== g.region && (
              <span class="vi-block-inline text-[0.9rem]" style="color: var(--vi-text)">
                {g.viRegion}
              </span>
            )}
            <span class="h-px flex-1" style="background: var(--border)" />
          </div>

          <div class="grid gap-3">
            {g.items.map((s) => (
              <article class="card p-5">
                <div class="flex items-baseline gap-3 flex-wrap">
                  <h3 class="font-mono font-medium text-[0.95rem]" style="color: var(--accent-cool)">
                    {s.code}
                  </h3>
                  {statusLabel[s.status] && (
                    <span class="chip" style={statusStyle[s.status]}>
                      {statusLabel[s.status]}
                      <span class="vi-block-inline font-normal" style="color: var(--vi-text)">· {viStatusLabel[s.status]}</span>
                    </span>
                  )}
                </div>
                <p class="font-medium mt-1.5">{s.title}</p>
                {s.viTitle && (
                  <p class="vi-block text-[0.9rem] mt-0.5 leading-snug" style="color: var(--vi-text)">
                    {s.viTitle}
                  </p>
                )}
                <p class="text-[0.9rem] mt-2 leading-relaxed" style="color: var(--text-muted)">
                  {s.note}
                </p>
                {s.viNote && (
                  <p class="vi-block vi-def text-[0.86rem] mt-1.5 leading-relaxed">{s.viNote}</p>
                )}
              </article>
            ))}
          </div>
        </section>
      ))
    }
  </div>
</Base>
